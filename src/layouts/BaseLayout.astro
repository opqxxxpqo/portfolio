---
import { ClientRouter } from 'astro:transitions';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import SEO from '~/components/SEO.astro';
import '~/styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** 首页调频器自带导航，不渲染全站 Header */
  hideHeader?: boolean;
}

const { title, description, ogImage, noindex, hideHeader = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <!-- 语言初始化：早于渲染读 localStorage / navigator.language 决定中英。
         设置 <html lang> 后所有 .lang-zh / .lang-en CSS 规则会立刻生效，避免闪烁。 -->
    <script is:inline>
      (function () {
        const readLang = () => {
          try {
            const saved = localStorage.getItem('lang');
            if (saved === 'zh' || saved === 'en') return saved;
          } catch (e) {}
          // 没保存过 -> 跟浏览器
          const nav = (navigator.language || 'zh').toLowerCase();
          return nav.startsWith('en') ? 'en' : 'zh';
        };
        const cur = readLang();
        document.documentElement.setAttribute('lang', cur === 'en' ? 'en' : 'zh-CN');
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- 字体：Inter (body) + Archivo Black (display) 来自 jsdelivr，国内访问稳定 -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5.0.16/index.css"
      media="print"
      onload="this.media='all'"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/archivo-black@5.0.20/400.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5.0.16/index.css" />
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/archivo-black@5.0.20/400.css" />
    </noscript>

    <SEO title={title} description={description} ogImage={ogImage} noindex={noindex} />

    <!-- 先于渲染恢复主题，避免闪烁。默认 dark；用户切换过会被 localStorage 覆盖 -->
    <!-- ClientRouter 跨页跳转时会把新页面的 <html data-theme="light"> 同步过来，
         所以也要在 astro:before-swap 时把保存的主题写到 newDocument，避免视觉闪回浅色 -->
    <script is:inline>
      (function () {
        const readTheme = () => {
          try {
            const saved = localStorage.getItem('theme');
            return saved === 'dark' || saved === 'light' ? saved : null;
          } catch (e) { return null; }
        };
        const applied = readTheme();
        if (applied) document.documentElement.setAttribute('data-theme', applied);

        document.addEventListener('astro:before-swap', (ev) => {
          const cur = readTheme();
          if (cur) ev.newDocument.documentElement.setAttribute('data-theme', cur);
          // 跨页跳转时也要把当前 lang 同步到新文档，否则 ClientRouter 把 newDocument 里的默认 zh-CN 套回来
          try {
            const lang = localStorage.getItem('lang');
            if (lang === 'zh' || lang === 'en') {
              ev.newDocument.documentElement.setAttribute('lang', lang === 'en' ? 'en' : 'zh-CN');
            }
          } catch (e) {}
        });

        // 跟踪导航历史给"返回上一级"用：ClientRouter 用 pushState，
        // document.referrer 不会随之更新，所以走 sessionStorage 自己记。
        // 每次 ClientRouter swap 完之后，把刚才那个页面的 URL 存起来。
        let lastPath = location.pathname + location.search;
        document.addEventListener('astro:after-swap', () => {
          try { sessionStorage.setItem('prevPath', lastPath); } catch (_) {}
          lastPath = location.pathname + location.search;
        });
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    {!hideHeader && <Header />}
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import '~/scripts/fx';
    </script>
  </body>
</html>
