---
export interface Props {
  src: string;
  alt?: string;
  poster?: string;
}
const { src, alt = '3D 模型', poster } = Astro.props;
---

<div class="model-block">
  <model-viewer
    src={src}
    alt={alt}
    poster={poster}
    camera-controls
    auto-rotate
    auto-rotate-delay="2000"
    rotation-per-second="20deg"
    environment-image="neutral"
    shadow-intensity="1"
    exposure="1"
    loading="lazy"
    reveal="auto"
  >
    <button slot="ar-button" style="display:none"></button>
    <div slot="progress-bar" class="progress-bar"></div>
  </model-viewer>
  <button class="toggle-rotate" type="button" aria-label="切换自动旋转 / Toggle auto-rotate">
    <span class="lang-zh">⟳ 自动旋转</span>
    <span class="lang-en">⟳ Auto-rotate</span>
  </button>
</div>

<script>
  // 走 npm 本地包；同时把 draco 解码器从默认的 gstatic 切到 jsdelivr（国内可达）
  import { ModelViewerElement } from '@google/model-viewer';
  ModelViewerElement.dracoDecoderLocation =
    'https://cdn.jsdelivr.net/npm/three@0.158.0/examples/jsm/libs/draco/gltf/';
</script>

<style>
  .model-block {
    position: relative;
    width: 100%;
    height: 540px;
    background: var(--bg-soft);
    border: var(--border-w-thick) solid var(--border);
    margin-bottom: 16px;
  }
  model-viewer {
    width: 100%;
    height: 100%;
    --poster-color: transparent;
  }
  .toggle-rotate {
    position: absolute;
    bottom: 12px;
    right: 12px;
    padding: 6px 12px;
    background: var(--bg);
    border: var(--border-w) solid var(--border);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all var(--transition);
  }
  .toggle-rotate:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .progress-bar {
    display: block;
    width: 33%;
    height: 3px;
    background: var(--accent);
  }
</style>

<script>
  function bindToggles() {
    document.querySelectorAll('.model-block').forEach(block => {
      const btn = block.querySelector('.toggle-rotate');
      const mv = block.querySelector('model-viewer') as any;
      if (!btn || !mv) return;
      btn.addEventListener('click', () => {
        mv.autoRotate = !mv.autoRotate;
      });
    });
  }
  bindToggles();
  document.addEventListener('astro:after-swap', bindToggles);
</script>
