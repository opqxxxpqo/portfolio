---
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};

const navItems = [
  { href: '/', zh: '首页', en: 'INDEX' },
  { href: '/categories', zh: '分类', en: 'CATEGORIES' },
  { href: '/about', zh: '关于', en: 'ABOUT' }
];
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" data-scramble-hover>
      <span data-scramble>QI LU®</span>
    </a>
    <nav>
      <ul>
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class={isActive(item.href) ? 'nav-link is-active' : 'nav-link'}
              data-scramble-hover
            >
              <span class="lang-zh"><span data-scramble>{item.zh}</span></span>
              <span class="lang-en"><span data-scramble>{item.en}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-tools">
      <LangToggle />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--hairline);
  }
  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 16px 32px;
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .brand {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    color: var(--fg);
  }
  nav { flex: 1; display: flex; justify-content: flex-end; }
  nav ul {
    list-style: none;
    display: flex;
    gap: 28px;
    padding: 0;
    margin: 0;
  }
  .nav-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: color var(--transition);
  }
  .nav-link:hover { color: var(--fg); }
  .nav-link.is-active {
    color: var(--fg);
    border-bottom: 1px solid var(--fg);
    padding-bottom: 2px;
  }
  .header-tools { display: flex; gap: 8px; align-items: center; margin-left: 12px; }

  @media (max-width: 640px) {
    .header-inner { gap: 12px; padding: 12px 20px; }
    nav ul { gap: 14px; }
    .nav-link { font-size: 0.6875rem; letter-spacing: 0.08em; }
    .brand { font-size: 0.8125rem; }
    .header-tools { gap: 4px; margin-left: 0; }
  }
</style>
