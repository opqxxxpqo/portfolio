---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};

const navItems = [
  { href: '/', label: '首页' },
  { href: '/categories', label: '分类' },
  { href: '/about', label: '关于我' }
];
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">Qi Lu</a>
    <nav>
      <ul>
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class={isActive(item.href) ? 'nav-link is-active' : 'nav-link'}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: var(--border-w) solid var(--border);
  }
  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-transform: uppercase;
  }
  nav { flex: 1; }
  nav ul {
    list-style: none;
    display: flex;
    gap: 4px;
    padding: 0;
    margin: 0;
  }
  .nav-link {
    display: inline-block;
    padding: 6px 14px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--fg);
    border: var(--border-w) solid transparent;
    transition: all var(--transition);
  }
  .nav-link:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .nav-link.is-active {
    border-color: var(--fg);
  }
  .nav-link.is-active:hover {
    background: var(--fg);
    color: var(--bg);
  }

  @media (max-width: 640px) {
    .header-inner { gap: 12px; padding: 14px 20px; }
    nav ul { gap: 2px; }
    .nav-link { padding: 4px 8px; font-size: 0.875rem; }
    .brand { font-size: 1rem; }
  }
</style>
