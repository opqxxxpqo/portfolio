---
// 详情页浮空幻灯片：点首页项目 → 就地弹出浮窗，横向翻页。
// 每个项目渲染一个惰性 <template>（克隆前图片不加载）；点击时克隆进浮窗初始化。
// 没有 deck 的项目点击回落到 /works/<slug> 独立页。
import type { Slide } from '~/lib/slides';

export interface Props {
  decks: { slug: string; title: string; titleEn: string; slides: Slide[] }[];
}
const { decks } = Astro.props;
---

{decks.map(deck => (
  <template class="deck-tpl" data-slug={deck.slug} data-title={deck.title} data-title-en={deck.titleEn}>
    <div class="pv-track">
      {deck.slides.map(s => {
        if (s.layout === 'cover') {
          return (
            <article class="slide slide--cover">
              <div class="slide-visual" style={'src' in s.img && s.img.bg ? `--visual-bg:${s.img.bg}` : undefined}>
                {'html' in s.img
                  ? <iframe src={s.img.html} loading="lazy" title="交互演示"></iframe>
                  : 'video' in s.img
                    ? (s.img.sound
                        ? <video src={s.img.video} controls playsinline preload="metadata"></video>
                        : <video src={s.img.video} muted loop autoplay playsinline preload="metadata"></video>)
                    : 'src' in s.img
                      ? <img src={s.img.src} alt="" loading="lazy" decoding="async" />
                      : <div class="slide-ph"><span class="mono-label">{s.img.ph}</span></div>}
              </div>
              <div class="slide-copy">
                <h2 class="slide-title" data-fx>
                  <span class="lang-zh">{s.title}</span>
                  <span class="lang-en">{s.titleEn}</span>
                </h2>
                <p class="slide-tagline">
                  <span class="lang-zh">{s.tagline}</span>
                  <span class="lang-en">{s.taglineEn}</span>
                </p>
                <dl class="slide-meta">
                  {s.meta.map(m => (
                    <div>
                      <dt class="mono-label">
                        <span class="lang-zh">{m.label}</span><span class="lang-en">{m.labelEn}</span>
                      </dt>
                      <dd>
                        <span class="lang-zh">{m.value}</span><span class="lang-en">{m.valueEn}</span>
                      </dd>
                    </div>
                  ))}
                </dl>
                {s.links && (
                  <div class="slide-links">
                    {s.links.map(l => (
                      <a href={l.url} target="_blank" rel="noopener" class="slide-link">
                        <span class="lang-zh">{l.label} ↗</span>
                        <span class="lang-en">{l.labelEn} ↗</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        }
        if (s.layout === 'text') {
          return (
            <article class={`slide slide--text ${s.side === 'left' ? 'is-left' : ''}`}>
              <div class="slide-copy">
                <h3 class="slide-heading" data-fx>
                  <span class="lang-zh">{s.heading}</span>
                  <span class="lang-en">{s.headingEn}</span>
                </h3>
                <div class="slide-body">
                  <div class="lang-zh">{s.body.map(p => <p>{p}</p>)}</div>
                  <div class="lang-en">{s.bodyEn.map(p => <p>{p}</p>)}</div>
                </div>
              </div>
              <div class="slide-visual" style={'src' in s.img && s.img.bg ? `--visual-bg:${s.img.bg}` : undefined}>
                {'html' in s.img
                  ? <iframe src={s.img.html} loading="lazy" title="交互演示"></iframe>
                  : 'video' in s.img
                    ? (s.img.sound
                        ? <video src={s.img.video} controls playsinline preload="metadata"></video>
                        : <video src={s.img.video} muted loop autoplay playsinline preload="metadata"></video>)
                    : 'src' in s.img
                      ? <img src={s.img.src} alt="" loading="lazy" decoding="async" />
                      : <div class="slide-ph"><span class="mono-label">{s.img.ph}</span></div>}
              </div>
            </article>
          );
        }
        if (s.layout === 'image') {
          return (
            <article class={`slide slide--image ${s.fill ? 'is-fill' : ''}`} style={'src' in s.img && s.img.bg ? `--visual-bg:${s.img.bg}` : undefined}>
              {'html' in s.img
                ? <iframe src={s.img.html} loading="lazy" title="交互演示"></iframe>
                : 'video' in s.img
                  ? (s.img.sound
                      ? <video src={s.img.video} controls playsinline preload="metadata"></video>
                      : <video src={s.img.video} muted loop autoplay playsinline preload="metadata"></video>)
                  : <img src={s.img.src} alt="" loading="lazy" decoding="async" />}
            </article>
          );
        }
        if (s.layout === 'item') {
          return (
            <article
              class="slide slide--item"
              style={'src' in s.img && s.img.bg ? `--visual-bg:${s.img.bg}` : undefined}
              data-model={s.model}
              data-poster={'src' in s.img ? s.img.src : undefined}
            >
              <div class="item-face">
                {'src' in s.img
                  ? <img class="item-poster" src={s.img.src} alt="" loading="lazy" decoding="async" />
                  : <div class="item-ph"><span class="mono-label">{s.img.ph}</span></div>}
                {s.model && (
                  <button class="item-enter3d" type="button">
                    <span class="lang-zh">3D 浏览</span><span class="lang-en">View in 3D</span>
                  </button>
                )}
                <div class="item-caption">
                  <div class="item-cap-l">
                    <span class="item-idx mono-label">{s.idx} / {s.total}</span>
                    <h3 class="item-name" data-fx>
                      <span class="lang-zh">{s.title}</span>
                      <span class="lang-en">{s.titleEn}</span>
                    </h3>
                  </div>
                  {s.link && (
                    <a class="item-link" href={s.link} target="_blank" rel="noopener">
                      <span class="lang-zh">看视频 ↗</span><span class="lang-en">Watch ↗</span>
                    </a>
                  )}
                </div>
              </div>
              {s.model && <div class="item-player" hidden></div>}
              {s.model && (
                <button class="item-back" type="button" hidden>
                  <span class="lang-zh">← 返回渲染图</span><span class="lang-en">← Back to render</span>
                </button>
              )}
            </article>
          );
        }
        if (s.layout === 'gallery') {
          return (
            <article class="slide slide--gallery">
              <div class="gallery-grid">
                {s.imgs.map(im => <img src={im.src} alt="" loading="lazy" decoding="async" />)}
              </div>
            </article>
          );
        }
        // links
        return (
          <article class="slide slide--links">
            <div class="slide-copy">
              <h3 class="slide-heading" data-fx>
                <span class="lang-zh">{s.heading}</span>
                <span class="lang-en">{s.headingEn}</span>
              </h3>
              {s.body && (
                <div class="slide-body">
                  <div class="lang-zh">{s.body.map(p => <p>{p}</p>)}</div>
                  <div class="lang-en">{(s.bodyEn || s.body).map(p => <p>{p}</p>)}</div>
                </div>
              )}
              <div class="slide-links">
                {s.links.map(l => (
                  <a href={l.url} target="_blank" rel="noopener" class="slide-link">
                    <span class="lang-zh">{l.label} ↗</span>
                    <span class="lang-en">{l.labelEn} ↗</span>
                  </a>
                ))}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </template>
))}

<!-- 浮窗外壳（单例，复用） -->
<div class="pv" id="pv" hidden aria-hidden="true">
  <div class="pv-backdrop" data-pv-close></div>
  <div class="pv-window" role="dialog" aria-modal="true" aria-label="项目详情">
    <header class="pv-top">
      <span class="pv-title mono-label" id="pv-title"></span>
      <button class="pv-close" type="button" data-pv-close aria-label="关闭">✕</button>
    </header>
    <div class="pv-stage" id="pv-stage"></div>
    <button class="pv-edge pv-edge--l" type="button" data-pv-prev aria-label="上一张"></button>
    <button class="pv-edge pv-edge--r" type="button" data-pv-next aria-label="下一张"></button>
    <footer class="pv-nav">
      <button class="pv-arrow" type="button" data-pv-prev aria-label="上一张">←</button>
      <span class="pv-dots" id="pv-dots"></span>
      <span class="pv-count mono-label" id="pv-count"></span>
      <button class="pv-arrow" type="button" data-pv-next aria-label="下一张">→</button>
    </footer>
  </div>
</div>

<style>
  .pv {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 4vh, 48px);
  }
  .pv[hidden] { display: none; }
  .pv-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(12, 12, 11, 0.55);
    opacity: 0;
    transition: opacity 320ms ease;
  }
  .pv.is-open .pv-backdrop { opacity: 1; }

  .pv-window {
    position: relative;
    width: min(1200px, 100%);
    height: min(760px, 100%);
    background: #ffffff;
    color: #121211;
    border: 1px solid var(--border);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(0.94);
    opacity: 0;
    transition: transform 380ms var(--ease-expo), opacity 300ms ease;
  }
  .pv.is-open .pv-window { transform: scale(1); opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .pv-backdrop, .pv-window { transition: none; }
  }

  .pv-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--hairline);
    flex: none;
  }
  .pv-title { color: var(--fg-muted); }
  .pv-close {
    width: 30px; height: 30px;
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent;
    border: 1px solid var(--tn-line-soft, rgba(18,18,17,.2));
    border-radius: 6px;
    color: #121211;
    font-size: 0.8125rem;
    transition: background var(--transition), color var(--transition);
  }
  .pv-close:hover { background: #121211; color: #fff; }

  .pv-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  .pv-track {
    display: flex;
    height: 100%;
    width: 100%;
    transition: transform 460ms var(--ease-expo);
  }
  @media (prefers-reduced-motion: reduce) { .pv-track { transition: none; } }

  .slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    min-width: 0;
    display: flex;
    overflow: hidden;
  }

  /* 封面 / 图文：两栏 */
  .slide--cover, .slide--text {
    align-items: stretch;
  }
  .slide-visual {
    flex: 0 0 56%;
    min-width: 0;
    /* --visual-bg 由 slides.ts 取自图片四角的画布色，contain 露出的部分就和图融成一块 */
    background: var(--visual-bg, #0c0c0b);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .slide-visual img { width: 100%; height: 100%; object-fit: cover; }
  /* 视频：静音循环、无控件，完整显示不裁切 */
  .slide-visual video { width: 100%; height: 100%; object-fit: contain; display: block; }
  /* HTML 交互嵌入：铺满配图区（能不能点由 .has-embed 关掉热区来保证，见下） */
  .slide-visual iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: #0c0c0b;
  }
  /* 小节配图比例杂，用 contain 完整显示（封面海报仍 cover 满幅）。
     露不露边由 --visual-bg 决定：取图自己的画布色，衬底和图融成一块。 */
  .slide--text .slide-visual img { object-fit: contain; }
  .slide-ph {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    background:
      repeating-linear-gradient(45deg, rgba(255,255,255,.04) 0 12px, transparent 12px 24px), #17171a;
    padding: 24px; text-align: center;
  }
  .slide-ph .mono-label { color: rgba(255,255,255,.5); }

  .slide-copy {
    flex: 1;
    min-width: 0;
    padding: clamp(24px, 4vw, 52px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    overflow-y: auto;
  }
  .slide--text.is-left { flex-direction: row-reverse; }

  .slide-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.5rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .slide-tagline { font-size: 1rem; line-height: 1.6; color: var(--fg-soft); margin: 0; }
  .slide-meta {
    margin: 8px 0 0; display: grid; gap: 10px;
    grid-template-columns: repeat(2, 1fr);
  }
  .slide-meta dt { margin: 0 0 2px; }
  .slide-meta dd { margin: 0; font-size: 0.875rem; }

  .slide-heading {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 900;
    margin: 0;
  }
  .slide-body p { font-size: 0.9375rem; line-height: 1.65; color: var(--fg-soft); margin: 0 0 0.8em; }
  .slide-body p:last-child { margin-bottom: 0; }

  /* 全幅大图 */
  .slide--image { background: var(--visual-bg, #0c0c0b); align-items: center; justify-content: center; }
  .slide--image img,
  .slide--image video { max-width: 100%; max-height: 100%; object-fit: contain; }
  /* is-fill：铺满整页、cover 裁切，无黑边（比例接近时只裁掉几个像素） */
  .slide--image.is-fill img,
  .slide--image.is-fill video { width: 100%; height: 100%; max-width: none; max-height: none; object-fit: cover; }
  .slide--image iframe { width: 100%; height: 100%; border: 0; background: #0c0c0b; }

  /* 合集子作品（视频类）：整幅静态封面 + 居中 ▶，点了就地内嵌播放 */
  .slide--item {
    position: relative;
    background: var(--visual-bg, #0c0c0b);
    align-items: stretch;
    justify-content: center;
  }
  .item-face { position: absolute; inset: 0; }
  .item-poster { width: 100%; height: 100%; object-fit: cover; display: block; }
  .item-ph {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg-soft, #ececec);
  }
  .item-ph .mono-label { color: var(--fg-muted); }
  /* 底部信息条：左标题、右链接/按钮 */
  .item-caption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding: clamp(24px, 4vw, 44px);
    background: linear-gradient(to top, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.45) 45%, rgba(0,0,0,0) 100%);
    color: #fff;
  }
  .item-cap-l { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .item-idx { color: rgba(255,255,255,0.7); }
  .item-name {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
  }
  /* 右侧「看视频」外链 / 「3D 浏览」入口 / 「返回渲染图」，同一套药丸样式 */
  .item-link, .item-enter3d, .item-back {
    flex: none;
    display: inline-flex;
    align-items: center;
    padding: 9px 18px;
    border: 1px solid rgba(255,255,255,0.6);
    border-radius: 999px;
    background: rgba(0,0,0,0.35);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }
  .item-link:hover, .item-enter3d:hover, .item-back:hover { background: #fff; color: #0c0c0b; border-color: #fff; }
  /* 3D 浏览入口：居中盖在渲染图上 */
  .item-enter3d {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
  }
  .item-enter3d:hover { transform: translate(-50%, -50%); }
  /* 进入 3D 后：渲染图隐藏、模型铺满、右上角出现返回键 */
  .slide--item.is-playing .item-face { display: none; }
  .item-player { position: absolute; inset: 0; background: #000; }
  .item-player model-viewer { width: 100%; height: 100%; display: block; background: #000; }
  .item-back { position: absolute; top: 16px; left: 16px; z-index: 4; }
  /* display:inline-flex 会盖掉 [hidden] 的 display:none，得显式补回 */
  .item-back[hidden] { display: none; }

  /* 角色网格 */
  .slide--gallery { padding: clamp(20px, 3vw, 40px); overflow-y: auto; }
  .gallery-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    align-content: start;
  }
  .gallery-grid img {
    width: 100%; aspect-ratio: 1 / 1; object-fit: cover;
    background: var(--bg-soft); border: 1px solid var(--hairline);
  }

  /* 链接收尾 */
  .slide--links { align-items: center; justify-content: center; }
  .slide--links .slide-copy { align-items: flex-start; max-width: 640px; }
  .slide-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .slide-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 8px 14px;
    border: 1px solid #121211;
    border-radius: 6px;
    color: #121211;
    transition: background var(--transition), color var(--transition);
  }
  .slide-link:hover { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }

  /* 左右点击热区 */
  .pv-edge {
    position: absolute;
    top: 52px; bottom: 56px;
    width: 15%;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 2;
  }
  .pv-edge--l { left: 0; }
  .pv-edge--r { right: 0; }
  .pv-edge[hidden] { display: none; }
  /* .pv-track 有 transform（自成层叠上下文），iframe 的 z-index 永远拼不过热区 —— 直接让热区失效 */
  .pv.has-embed .pv-edge { pointer-events: none; }

  /* 底部导航 */
  .pv-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 12px 20px;
    border-top: 1px solid var(--hairline);
    flex: none;
  }
  .pv-arrow {
    width: 30px; height: 30px;
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent; border: 1px solid var(--hairline); border-radius: 6px;
    color: #121211; font-family: var(--font-mono);
    transition: background var(--transition), color var(--transition), opacity var(--transition);
  }
  .pv-arrow:hover { background: #121211; color: #fff; }
  .pv-arrow:disabled { opacity: 0.25; cursor: default; }
  .pv-arrow:disabled:hover { background: transparent; color: #121211; }
  .pv-dots { display: inline-flex; gap: 7px; }
  .pv-dots i {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--fg-muted); opacity: 0.35;
    transition: opacity var(--transition), background var(--transition);
    cursor: pointer;
  }
  .pv-dots i.on { opacity: 1; background: var(--accent); }
  .pv-count { color: var(--fg-muted); min-width: 5ch; text-align: right; }

  @media (max-width: 768px) {
    .pv { padding: 0; }
    .pv-window { width: 100%; height: 100%; border: none; border-radius: 0; }
    .slide--cover, .slide--text, .slide--text.is-left { flex-direction: column; }
    .slide-visual { flex: 0 0 44%; }
    .slide-copy { justify-content: flex-start; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    .pv-edge { display: none; }
  }
</style>

<script>
  function setupSlideshow() {
    const pv = document.getElementById('pv');
    const stage = document.getElementById('pv-stage');
    const titleEl = document.getElementById('pv-title');
    const dotsEl = document.getElementById('pv-dots');
    const countEl = document.getElementById('pv-count');
    if (!pv || !stage || !titleEl || !dotsEl || !countEl || pv.dataset.bound) return;
    pv.dataset.bound = '1';

    const decks = new Map<string, HTMLTemplateElement>();
    document.querySelectorAll<HTMLTemplateElement>('.deck-tpl').forEach(t => {
      if (t.dataset.slug) decks.set(t.dataset.slug, t);
    });
    if (decks.size === 0) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pad2 = (n: number) => String(n).padStart(2, '0');
    let track: HTMLElement | null = null;
    let slides: HTMLElement[] = [];
    let idx = 0;
    const arrows = () => Array.from(pv.querySelectorAll<HTMLButtonElement>('.pv-arrow'));

    const scrambleActive = () => {
      if (reduced || !slides[idx]) return;
      slides[idx].querySelectorAll<HTMLElement>('[data-fx] .lang-zh, [data-fx] .lang-en')
        .forEach(el => { if (el.offsetParent !== null) (window as any).__fx?.scramble?.(el, { stagger: 16, jitter: 80 }); });
    };

    // 当前页有可交互内容（iframe demo / 可旋转 3D / 合集右侧外链）时让出左右点击热区，
    // 避免热区盖住它们的控件/拖拽/链接；翻页仍走滚轮/底部箭头/键盘。
    // 3D 入口按钮居中、不压边，所以不列入——好让 3D 封面页仍能点两侧翻页。
    const syncEdges = () => {
      pv.classList.toggle('has-embed', !!slides[idx]?.querySelector('iframe, video[controls], model-viewer, .item-link'));
    };

    const goto = (n: number) => {
      idx = Math.max(0, Math.min(slides.length - 1, n));
      if (track) track.style.transform = `translateX(${-idx * 100}%)`;
      // 翻页离开时暂停带声音的演示视频，别让它在别的页面继续响
      stage.querySelectorAll<HTMLVideoElement>('video[controls]').forEach(v => { if (!v.paused) v.pause(); });
      // 翻页时把已进入 3D / 播放的合集页复位（停声、清模型、恢复渲染图、收起返回键）
      stage.querySelectorAll<HTMLElement>('.slide--item.is-playing').forEach(art => {
        art.querySelectorAll('video').forEach(v => v.pause());
        const p = art.querySelector<HTMLElement>('.item-player');
        if (p) { p.innerHTML = ''; p.hidden = true; }
        art.querySelector<HTMLElement>('.item-back')?.setAttribute('hidden', '');
        art.classList.remove('is-playing');
      });
      syncEdges();
      countEl.textContent = pad2(idx + 1) + ' / ' + pad2(slides.length);
      dotsEl.querySelectorAll('i').forEach((d, i) => d.classList.toggle('on', i === idx));
      arrows().forEach(a => {
        const isPrev = a.getAttribute('data-pv-prev') !== null;
        a.disabled = isPrev ? idx === 0 : idx === slides.length - 1;
      });
      scrambleActive();
    };

    const openDeck = (slug: string) => {
      const tpl = decks.get(slug);
      if (!tpl) return;
      stage.innerHTML = '';
      stage.appendChild(tpl.content.cloneNode(true));
      track = stage.querySelector('.pv-track');
      slides = Array.from(stage.querySelectorAll<HTMLElement>('.slide'));
      // 克隆进来的静音循环视频（配图/内容）需要主动 play；
      // 带控件的是「声音就是内容」的演示视频（音频类作品），不静音也不自动播
      stage.querySelectorAll<HTMLVideoElement>('video:not([controls])').forEach(v => { v.muted = true; v.play().catch(() => {}); });
      titleEl.textContent = (document.documentElement.lang || '').startsWith('en')
        ? (tpl.dataset.titleEn || tpl.dataset.title || '')
        : (tpl.dataset.title || '');
      dotsEl.innerHTML = slides.map(() => '<i></i>').join('');
      dotsEl.querySelectorAll('i').forEach((d, i) => d.addEventListener('click', () => goto(i)));
      if (track && reduced) track.style.transition = 'none';
      pv.hidden = false;
      pv.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => pv.classList.add('is-open'));
      idx = 0;
      goto(0);
    };

    // 合集 3D 页：点「3D 浏览」就地加载可旋转模型，点「返回渲染图」退回封面。
    // 委托绑在常驻的 stage 上。（视频页是普通外链 <a>，无需 JS。）
    const exit3d = (art: HTMLElement) => {
      const player = art.querySelector<HTMLElement>('.item-player');
      if (player) { player.innerHTML = ''; player.hidden = true; }
      art.querySelector<HTMLElement>('.item-back')?.setAttribute('hidden', '');
      art.classList.remove('is-playing');
    };
    stage.addEventListener('click', e => {
      const enter = (e.target as HTMLElement).closest('.item-enter3d');
      const back = (e.target as HTMLElement).closest('.item-back');
      if (enter) {
        const art = enter.closest<HTMLElement>('.slide--item');
        const player = art?.querySelector<HTMLElement>('.item-player');
        const model = art?.dataset.model;
        if (!art || !player || !model || art.classList.contains('is-playing')) return;
        if (!customElements.get('model-viewer')) import('@google/model-viewer').catch(() => {});
        // 行内 style：运行时注入的元素拿不到 Astro 的作用域属性，作用域 CSS 不生效，得靠 style 撑满
        player.innerHTML = `<model-viewer src="${model}" poster="${art.dataset.poster || ''}" camera-controls auto-rotate auto-rotate-delay="1500" rotation-per-second="20deg" environment-image="neutral" shadow-intensity="1" exposure="1" loading="eager" style="width:100%;height:100%;display:block;background:#000"></model-viewer>`;
        player.hidden = false;
        art.querySelector<HTMLElement>('.item-back')?.removeAttribute('hidden');
        art.classList.add('is-playing');
        syncEdges();
      } else if (back) {
        const art = back.closest<HTMLElement>('.slide--item');
        if (art) { exit3d(art); syncEdges(); }
      }
    });

    const close = () => {
      // 立刻暂停内嵌视频，别让声音在关闭动画里继续响（B站 iframe 靠随后清空 DOM 停掉）
      stage.querySelectorAll('video').forEach(v => v.pause());
      pv.classList.remove('is-open');
      const done = () => {
        pv.hidden = true;
        pv.setAttribute('aria-hidden', 'true');
        stage.innerHTML = '';
        track = null; slides = [];
        document.body.style.overflow = '';
      };
      if (reduced) done();
      else setTimeout(done, 320);
    };

    // 拦截首页项目点击（capture 阶段，抢在 ClientRouter 的 SPA 跳转之前）
    document.addEventListener('click', e => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.feed-item, .row-link');
      if (!link) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || (e as MouseEvent).button === 1) return; // 新标签/独立页兜底
      const m = link.getAttribute('href')?.match(/\/works\/([^/]+)\/?$/);
      const slug = m?.[1];
      if (!slug || !decks.has(slug)) return; // 没 deck 的走默认跳转
      e.preventDefault();
      e.stopPropagation();
      openDeck(slug);
    }, true);

    pv.querySelectorAll('[data-pv-close]').forEach(el => el.addEventListener('click', close));
    pv.querySelectorAll('[data-pv-prev]').forEach(el => el.addEventListener('click', () => goto(idx - 1)));
    pv.querySelectorAll('[data-pv-next]').forEach(el => el.addEventListener('click', () => goto(idx + 1)));

    document.addEventListener('keydown', e => {
      if (pv.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') goto(idx - 1);
      else if (e.key === 'ArrowRight') goto(idx + 1);
    });

    // 滚轮翻页。触控板一次划动会连发几十个小 delta，所以翻完上锁，
    // 等它彻底停下（120ms 没有新事件）才解锁，避免一划飞好几页。
    let wheelLock = false;
    let wheelIdle: number | undefined;
    stage.addEventListener('wheel', e => {
      // 3D 模型上滚轮是缩放，交给 model-viewer 自己处理，别抢来翻页
      if ((e.target as HTMLElement).closest('model-viewer')) return;
      // 文字栏能滚就先滚它，滚到头再翻页
      const copy = (e.target as HTMLElement).closest<HTMLElement>('.slide-copy, .slide--gallery');
      if (copy && copy.scrollHeight > copy.clientHeight + 1) {
        const atTop = copy.scrollTop <= 0;
        const atEnd = copy.scrollTop + copy.clientHeight >= copy.scrollHeight - 1;
        if (!(e.deltaY < 0 ? atTop : atEnd)) return;
      }
      e.preventDefault();
      clearTimeout(wheelIdle);
      wheelIdle = window.setTimeout(() => { wheelLock = false; }, 120);
      if (wheelLock) return;
      const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      if (Math.abs(d) < 8) return;
      const next = idx + Math.sign(d);
      if (next < 0 || next > slides.length - 1) return; // 到头了就别锁，留着让它继续滚
      wheelLock = true;
      goto(next);
    }, { passive: false });

    // 移动端：横滑翻页 / 下滑关闭
    let sx = 0, sy = 0;
    stage.addEventListener('touchstart', e => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    stage.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - sx;
      const dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 50) goto(idx - Math.sign(dx));
      else if (dy > 90 && Math.abs(dx) < 60) close();
    }, { passive: true });
  }

  setupSlideshow();
  document.addEventListener('astro:after-swap', setupSlideshow);
</script>
