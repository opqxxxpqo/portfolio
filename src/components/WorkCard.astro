---
import { CATEGORY_MAP } from '~/lib/categories';

export interface Props {
  slug: string;
  title: string;
  summary: string;
  cover: string;
  category: keyof typeof CATEGORY_MAP;
  date: Date;
  size?: 'default' | 'large';
}

const { slug, title, summary, cover, category, date, size = 'default' } = Astro.props;
const cat = CATEGORY_MAP[category];
const dateStr = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'short'
}).format(date);
---

<a href={`/works/${slug}`} class={`work-card ${size}`} data-astro-prefetch>
  <div class="cover-wrap">
    <img
      src={cover}
      alt={`${title} 封面`}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="card-body">
    <div class="card-meta">
      <span class="cat">{cat.label}</span>
      <span class="dot">·</span>
      <time>{dateStr}</time>
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-summary">{summary}</p>
  </div>
</a>

<style>
  .work-card {
    display: block;
    color: inherit;
  }
  .cover-wrap {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--bg-soft);
    border: 1px solid var(--border);
  }
  .cover-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .work-card:hover .cover-wrap img {
    transform: scale(1.02);
  }
  .card-body {
    padding-top: 16px;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--fg-muted);
    margin-bottom: 8px;
  }
  .cat { color: var(--accent); font-weight: 500; }
  .dot { color: var(--border); }
  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--fg);
    transition: color var(--transition);
  }
  .work-card:hover .card-title { color: var(--accent); }
  .card-summary {
    color: var(--fg-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-card.large .card-title {
    font-size: 1.5rem;
  }
  .work-card.large .card-summary {
    font-size: 1.0625rem;
    -webkit-line-clamp: 3;
  }
</style>
