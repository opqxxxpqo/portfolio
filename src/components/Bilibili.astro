---
export interface Props {
  bvid: string;
  title?: string;
  page?: number;
}
const { bvid, title = 'Bilibili 视频', page = 1 } = Astro.props;
const src = `//player.bilibili.com/player.html?bvid=${bvid}&page=${page}&high_quality=1&danmaku=0`;
---

<div class="bilibili-wrap">
  <iframe
    src={src}
    title={title}
    referrerpolicy="no-referrer"
    allowfullscreen={true}
    loading="lazy"
  ></iframe>
</div>

<style>
  .bilibili-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--bg-soft);
    border: var(--border-w-thick) solid var(--border);
    margin-bottom: 16px;
  }
  .bilibili-wrap iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
</style>
