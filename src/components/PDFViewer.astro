---
export interface Props {
  src: string;
  height?: number;
  noDownload?: boolean;  // true 时不显示下载按钮，只在线浏览
}
const { src, height = 720, noDownload = false } = Astro.props;
const fileName = src.split('/').pop() || 'document.pdf';
// PDF.js / 浏览器内置 PDF 查看器的工具栏参数：禁用下载/打印按钮
const embedSrc = noDownload ? `${src}#toolbar=1&navpanes=0&scrollbar=1&statusbar=0` : src;
---

<div class="pdf-block">
  <div class="pdf-bar">
    <span class="pdf-name">{fileName}</span>
    {!noDownload && (
      <a href={src} download class="pdf-download">
        <span class="lang-zh">下载 PDF ↓</span>
        <span class="lang-en">Download PDF ↓</span>
      </a>
    )}
  </div>
  <object
    data={embedSrc}
    type="application/pdf"
    style={`width: 100%; height: ${height}px;`}
  >
    <div class="pdf-fallback">
      <span class="lang-zh">你的浏览器不支持内嵌 PDF。</span>
      <span class="lang-en">Your browser can't display this PDF inline.</span>
      {!noDownload && (
        <a href={src} class="link-underline">
          <span class="lang-zh">点击下载</span>
          <span class="lang-en">Download instead</span>
        </a>
      )}
    </div>
  </object>
</div>

<style>
  .pdf-block {
    border: var(--border-w-thick) solid var(--border);
    margin-bottom: 16px;
    background: var(--bg-soft);
  }
  .pdf-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: var(--border-w) solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pdf-name { color: var(--fg-muted); }
  .pdf-download {
    color: var(--fg);
    padding: 4px 10px;
    border: var(--border-w) solid var(--border);
    transition: all var(--transition);
  }
  .pdf-download:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .pdf-fallback {
    padding: 32px;
    text-align: center;
    color: var(--fg-soft);
  }
</style>
