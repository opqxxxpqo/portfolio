---
export interface Props {
  src: string;
  height?: number;
}
const { src, height = 720 } = Astro.props;
const fileName = src.split('/').pop() || 'document.pdf';
---

<div class="pdf-block">
  <div class="pdf-bar">
    <span class="pdf-name">{fileName}</span>
    <a href={src} download class="pdf-download">下载 PDF ↓</a>
  </div>
  <object
    data={src}
    type="application/pdf"
    style={`width: 100%; height: ${height}px;`}
  >
    <div class="pdf-fallback">
      你的浏览器不支持内嵌 PDF。
      <a href={src} class="link-underline">点击下载</a>
    </div>
  </object>
</div>

<style>
  .pdf-block {
    border: var(--border-w-thick) solid var(--border);
    margin-bottom: 16px;
    background: var(--bg-soft);
  }
  .pdf-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: var(--border-w) solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pdf-name { color: var(--fg-muted); }
  .pdf-download {
    color: var(--fg);
    padding: 4px 10px;
    border: var(--border-w) solid var(--border);
    transition: all var(--transition);
  }
  .pdf-download:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .pdf-fallback {
    padding: 32px;
    text-align: center;
    color: var(--fg-soft);
  }
</style>
