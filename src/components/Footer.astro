---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-cta">
    <p class="mono-label">
      <span class="lang-zh">下一步 →</span>
      <span class="lang-en">NEXT →</span>
    </p>
    <a href="mailto:luqiapp2007@163.com" class="footer-talk" data-scramble-hover>
      <span class="lang-zh"><span data-scramble>聊聊 ↗</span></span>
      <span class="lang-en"><span data-scramble>LET'S TALK ↗</span></span>
    </a>
    <p class="footer-mail mono-label">luqiapp2007@163.com</p>
  </div>

  <div class="footer-meta">
    <ul class="meta-links">
      <li><a href="https://github.com/opqxxxpqo" rel="noopener" target="_blank" data-scramble-hover><span data-scramble>GITHUB ↗</span></a></li>
      <li><a href="/resume.pdf" data-scramble-hover><span data-scramble>RESUME ↓</span></a></li>
      <li>
        <a href="/process" data-scramble-hover>
          <span class="lang-zh"><span data-scramble>此站如何搭建</span></span>
          <span class="lang-en"><span data-scramble>HOW THIS SITE WAS BUILT</span></span>
        </a>
      </li>
    </ul>
    <span class="meta-copy">© {year} QI LU — BUILT WITH ASTRO · CLAUDE CODE</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 120px;
    border-top: 1px solid var(--hairline);
    background: var(--bg);
  }
  .footer-cta {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(56px, 10vh, 120px) 32px;
  }
  .footer-cta .mono-label { display: block; margin: 0 0 20px; }
  .footer-talk {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(3rem, 11vw, 9rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--fg);
    transition: color var(--transition);
  }
  .footer-talk:hover { color: var(--accent); }
  .footer-mail { margin: 24px 0 0; }

  .footer-meta {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 20px 32px 28px;
    border-top: 1px solid var(--hairline);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
  }
  .meta-links {
    list-style: none;
    display: flex;
    gap: 24px;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }
  .meta-links a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: color var(--transition);
  }
  .meta-links a:hover { color: var(--fg); }
  .meta-copy {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .site-footer { margin-top: 80px; }
    .footer-cta { padding: 56px 20px; }
    .footer-meta { flex-direction: column; gap: 14px; padding: 20px 20px 24px; }
    .meta-links { gap: 16px; }
  }
</style>
