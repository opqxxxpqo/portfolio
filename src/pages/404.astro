---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="404 · 页面未找到" noindex={true}>
  <section class="notfound">
    <div class="container-narrow">
      <p class="big">404</p>
      <h1>
        <span class="lang-zh">这里没有内容。</span>
        <span class="lang-en">Nothing here.</span>
      </h1>
      <p class="dim">
        <span class="lang-zh">你访问的页面不存在或已被移动。</span>
        <span class="lang-en">The page you requested does not exist or has been moved.</span>
      </p>
      <div class="links">
        <a href="/" class="chunky-btn primary">
          <span class="lang-zh">← 返回首页</span>
          <span class="lang-en">← Back to home</span>
        </a>
        <a href="/categories" class="chunky-btn">
          <span class="lang-zh">浏览分类</span>
          <span class="lang-en">Browse categories</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding: 120px 0 160px;
    min-height: 60vh;
  }
  .big {
    font-family: var(--font-display);
    font-size: clamp(6rem, 22vw, 16rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--accent);
    margin-bottom: 24px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 3rem);
    margin-bottom: 16px;
    font-weight: 900;
  }
  .dim { color: var(--fg-soft); margin-bottom: 40px; font-size: 1.0625rem; }
  .links { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
