---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import LangToggle from '~/components/LangToggle.astro';
import Slideshow from '~/components/Slideshow.astro';
import { CATEGORY_MAP } from '~/lib/categories';
import { buildSlides } from '~/lib/slides';

const all = await getCollection('works');
const worksEnAll = await getCollection('worksEn');
const enBodyMap = new Map(worksEnAll.map(e => [e.id, e.body || '']));

// 隐藏 hidden:true 的作品（合集子项），按时间倒序
const works = all
  .filter(w => !w.data.hidden)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const yearFmt = (d: Date) => d.getFullYear().toString();
const pad = (n: number) => n.toString().padStart(2, '0');

// 幻灯片 deck：有 slides 的项目点击弹浮窗，其余回落独立页
const decks = works
  .map(w => ({ slug: w.id, title: w.data.title, titleEn: (w.data as any).titleEn || w.data.title, slides: buildSlides(w, enBodyMap.get(w.id)) }))
  .filter((d): d is { slug: string; title: string; titleEn: string; slides: NonNullable<ReturnType<typeof buildSlides>> } => d.slides !== null);

// 每个作品是一个频点。频点必须落在尺子的格点上（整 MHz），数字和刻度才对得上：
// ≤10 个作品时用 89/91/93…（全部落在 1MHz 中刻度，间距均匀）；更多时吸附到 0.5MHz 格
const stationFreq = (i: number, n: number) =>
  n <= 10 ? 89 + i * 2 : Math.round((87.5 + ((i + 0.5) / n) * 20.5) * 2) / 2;
const stations = works.map((w, i) => {
  const freq = stationFreq(i, works.length);
  return {
    id: w.id,
    pos: (freq - 87.5) / (108 - 87.5), // 0..1 频段位置
    freq: freq.toFixed(1)
  };
});

// 刻度：每 0.5MHz 一根，精确定位（不用 repeating-gradient，杜绝参差杂线）
// tier: major = 2MHz（带数字标注）/ mid = 1MHz / minor = 0.5MHz
type Tick = { pos: number; tier: 'major' | 'mid' | 'minor'; label?: number };
const ticks: Tick[] = [];
for (let f = 88; f <= 108; f += 0.5) {
  const pos = ((f - 87.5) / (108 - 87.5)) * 100;
  const tier = f % 2 === 0 ? 'major' : f % 1 === 0 ? 'mid' : 'minor';
  ticks.push({ pos, tier, label: tier === 'major' ? f : undefined });
}
---

<BaseLayout
  hideHeader
  title="鲁琦 Qi Lu · 作品集"
  description="拉夫堡大学服务设计创新硕士 · 视觉传达背景 · 服务设计 / UX·UI / AI 原型 / 视觉与 3D · 持续更新"
>
  <!-- ========== 着陆首屏：居中大字，滚走后只剩调频器 ========== -->
  <section class="landing" id="landing">
    <canvas class="landing-fx" id="landing-fx" aria-hidden="true"></canvas>
    <p class="landing-blurb mono-label">
      <span class="lang-zh">设计工程师 · 交付能落地的 AI 原型</span>
      <span class="lang-en">DESIGN ENGINEER — SHIPPING AI PROTOTYPES THAT WORK</span>
    </p>
    <a class="landing-about" href="/about" data-scramble-hover>
      <span class="lang-zh"><span data-scramble>关于我 →</span></span>
      <span class="lang-en"><span data-scramble>ABOUT ME →</span></span>
    </a>
    <div class="landing-center">
      <h1 class="landing-wordmark"><span>Qi Lu Portfolio</span></h1>
      <div class="landing-lang">
        <LangToggle />
      </div>
    </div>
    <p class="landing-scroll mono-label" aria-hidden="true">
      <span class="lang-zh">下滑调台 ↓</span>
      <span class="lang-en">SCROLL DOWN ↓</span>
    </p>
  </section>

  <!-- ========== 固定调频器：居中，着陆屏时隐藏 ========== -->
  <section class="tuner" id="tuner" tabindex="0" aria-label="Project tuner">
    <div class="tuner-inner">
      <div class="tn-toprow">
        <div class="tn-tools">
          <LangToggle />
        </div>
        <a class="tn-about" href="/about" data-astro-prefetch>
          <span class="lang-zh">关于我 →</span>
          <span class="lang-en">ABOUT ME →</span>
        </a>
      </div>

      <div class="tn-scale" id="tn-scale">
        <div class="tn-mhz" aria-hidden="true">
          {ticks.filter(t => t.label).map(t => (
            <span style={`left:${t.pos}%`}>{t.label}</span>
          ))}
        </div>
        <div class="tn-ticks" aria-hidden="true">
          {ticks.map(t => (
            <i class={`tick tick--${t.tier}`} style={`left:${t.pos}%`} />
          ))}
        </div>
        {stations.map((s, i) => (
          <button
            class="tn-station"
            type="button"
            style={`left:${s.pos * 100}%`}
            data-idx={i}
            aria-label={`Project ${pad(i + 1)} — ${s.freq} MHz`}
          >
            <span class="tn-station-mark" aria-hidden="true"></span>
            <span class="tn-station-no mono-label">{pad(i + 1)}</span>
          </button>
        ))}
        <div class="tn-needle" id="tn-needle" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- ========== 项目流：桌面 sticky 叠层盖入，移动端短幅列表流 ========== -->
  <div class="feed" id="feed">
    {works.map((w, i) => {
      const cat = CATEGORY_MAP[w.data.category as keyof typeof CATEGORY_MAP];
      const fseq = (w.data as any).frameSeq as { base: string; count: number; ext?: string } | undefined;
      return (
        <a
          class="feed-item"
          data-idx={i}
          id={`fi-${i}`}
          href={`/works/${w.id}`}
          data-astro-prefetch
          data-frames-base={fseq ? fseq.base : undefined}
          data-frames-count={fseq ? String(fseq.count) : undefined}
          data-frames-ext={fseq ? (fseq.ext || 'jpg') : undefined}
        >
          <span class="feed-meta">
            <span class="feed-idx mono-label">{pad(i + 1)}</span>
            <span class="feed-title">
              <span class="lang-zh">{w.data.title}</span>
              <span class="lang-en">{(w.data as any).titleEn || w.data.title}</span>
            </span>
            <span class="feed-cat mono-label">
              <span class="lang-zh">{w.data.chip || cat?.labelZh || cat?.label || w.data.category}</span>
              <span class="lang-en">{w.data.chipEn || w.data.chip || cat?.label || w.data.category}</span>
              <span class="feed-year">( {yearFmt(w.data.date)} )</span>
            </span>
            <span class="feed-view mono-label" aria-hidden="true">
              <span class="lang-zh">查看 case study →</span>
              <span class="lang-en">VIEW CASE STUDY →</span>
            </span>
          </span>
          <span class="feed-poster px-host">
            <img
              src={(w.data as any).poster || w.data.cover}
              alt={`${w.data.title} 海报`}
              loading={i <= 1 ? 'eager' : 'lazy'}
              decoding="async"
            />
            {fseq && <canvas class="scrub-canvas" aria-hidden="true"></canvas>}
          </span>
        </a>
      );
    })}
  </div>

  <script type="application/json" id="stations-data" set:html={JSON.stringify(stations)} />

  <Slideshow decks={decks} />
</BaseLayout>

<style>
  /* ============ 着陆首屏 ============ */
  .landing {
    position: relative;
    height: 100svh;
    display: grid;
    place-items: center;
    background: #ffffff;              /* 纯白，与调频器 / 标题栏统一 */
    color: #121211;                  /* 白底固定深字 */
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
    cursor: crosshair;
  }
  .landing .mono-label { color: #8b897f; }
  .landing-about { color: #121211; }
  /* ASCII 背景特效层：铺满、置底、不挡交互 */
  .landing-fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .landing-blurb {
    position: absolute;
    top: 20px;
    left: 32px;
    margin: 0;
    z-index: 1;
  }
  .landing-about {
    position: absolute;
    top: 20px;
    right: 32px;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #121211;
    transition: color var(--transition);
  }
  .landing-about:hover { color: var(--accent); }
  .landing-center {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }
  /* 台标：Lobster 手写脚本体 */
  .landing-wordmark {
    font-family: 'Lobster', 'Brush Script MT', cursive;
    font-style: normal;
    font-weight: 400;
    font-size: clamp(3.5rem, 10vw, 9rem);
    line-height: 1.15;
    letter-spacing: 0.01em;
    margin: 0;
    text-align: center;
  }
  .landing-scroll {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    z-index: 1;
  }
  /* 着陆页切换按钮：低调细体、无底色无边框、淡色（覆盖 LangToggle 默认样式） */
  .landing-lang :global(.lang-toggle) {
    height: auto;
    padding: 0;
    gap: 6px;
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: #8b897f;
  }
  .landing-lang :global(.lang-toggle:hover) {
    background: transparent;
    color: #55534c;
  }
  .landing-lang :global(.seg) {
    font-weight: 300;
    opacity: 0.4;
    transition: opacity var(--transition);
  }
  .landing-lang :global(.seg-sep) { opacity: 0.25; }
  /* 当前语言：仅靠不透明度轻微区分，不加粗不放大 */
  :global(html[lang^='zh']) .landing-lang :global(.seg-zh),
  :global(html[lang^='en']) .landing-lang :global(.seg-en) {
    opacity: 0.9;
    font-weight: 300;
  }

  /* ============ 固定调频器：居中窄容器 ============ */
  .tuner {
    --tn-bg: #ffffff;
    --tn-fg: #121211;
    --tn-muted: #8b897f;
    --tn-line: rgba(18, 18, 17, 0.55);
    --tn-line-soft: rgba(18, 18, 17, 0.22);
    --tn-red: #e5352b;

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--tn-bg);
    color: var(--tn-fg);
    border-bottom: 1px solid var(--hairline);
    outline: none;
    user-select: none;

    /* 着陆屏时藏起，滚进项目流后滑入 */
    transform: translateY(-100%);
    transition: transform 300ms var(--ease-expo);
  }
  .tuner.is-on { transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .tuner { transition: none; }
  }

  .tuner-inner {
    max-width: 920px;
    margin: 0 auto;
    padding: 12px 32px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tn-toprow {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  /* 中文/EN 在调频左侧，圆角边框 */
  .tn-tools { display: flex; gap: 6px; align-items: center; flex: none; }
  .tn-tools :global(button) {
    background: transparent !important;
    border-color: var(--tn-line-soft) !important;
    color: var(--tn-fg) !important;
    height: 28px !important;
    border-radius: 6px !important;
  }
  /* 关于我 —— 推到调频栏最右侧 */
  .tn-about {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tn-fg);
    white-space: nowrap;
    transition: color var(--transition);
  }
  .tn-about:hover { color: var(--accent); }

  /* ---------- 刻度带：精确刻度，无杂线 ---------- */
  .tn-scale {
    position: relative;
    height: 74px;
    cursor: ew-resize;
    touch-action: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 20px, #000 calc(100% - 20px), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 20px, #000 calc(100% - 20px), transparent 100%);
  }
  .tn-mhz {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 12px;
    pointer-events: none;
  }
  .tn-mhz span {
    position: absolute;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    color: var(--tn-muted);
    font-variant-numeric: tabular-nums;
  }
  .tn-ticks {
    position: absolute;
    inset: 16px 0 20px;
    pointer-events: none;
  }
  .tick {
    position: absolute;
    top: 0;
    width: 1px;
    transform: translateX(-50%);
    background: var(--tn-line-soft);
  }
  .tick--minor { height: 38%; }
  .tick--mid { height: 62%; background: var(--tn-line); }
  .tick--major { height: 100%; background: var(--tn-fg); width: 1px; }

  .tn-station {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 26px;
    transform: translateX(-50%);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  /* 频点标记与刻度同一坐标系：和大刻度同顶同底，只靠加粗区分 */
  .tn-station-mark {
    position: absolute;
    left: 50%;
    top: 16px;
    bottom: 20px;
    width: 3px;
    transform: translateX(-50%);
    background: var(--tn-fg);
    transition: background var(--transition);
  }
  .tn-station:hover .tn-station-mark { background: var(--tn-red); }
  .tn-station.is-active .tn-station-mark { background: var(--tn-red); }
  .tn-station-no {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    color: var(--tn-muted);
    font-size: 0.625rem;
    transition: color var(--transition);
  }
  .tn-station.is-active .tn-station-no { color: var(--tn-red); }

  .tn-needle {
    position: absolute;
    top: 12px;
    bottom: 14px;
    left: -1px; /* 2px 针身的一半，针心正对频点 */
    width: 2px;
    background: var(--tn-red);
    box-shadow: 0 0 8px rgba(229, 53, 43, 0.55);
    pointer-events: none;
    will-change: transform;
  }
  .tn-needle::after {
    content: '';
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--tn-red);
  }

  /* ============ 项目流 ============ */
  /* 桌面：sticky 叠层，下一个盖住上一个 */
  .feed-item {
    position: sticky;
    top: var(--tuner-h, 120px);
    display: flex;
    flex-direction: column;
    height: calc(100svh - var(--tuner-h, 120px));
    color: #121211;      /* 白底固定深字，不受站点深色主题影响 */
    background: #ffffff; /* 纯白标题栏，与调频器 / 着陆页统一；不透明才能盖住上一个 */
    border-top: 1px solid var(--hairline);
  }
  .feed-meta {
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 14px 32px;
  }
  .feed-title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .feed-cat { white-space: nowrap; }
  .feed-year { margin-left: 6px; }
  .feed-view {
    margin-left: auto;
    color: #121211;
    border-bottom: 1px solid #121211;
    padding-bottom: 2px;
    white-space: nowrap;
    transition: color var(--transition), border-color var(--transition);
  }
  .feed-item:hover .feed-view { color: var(--accent); border-color: var(--accent); }

  .feed-poster {
    display: block;
    position: relative;
    flex: 1;
    min-height: 0;
    width: 100%;
    background: #0c0c0b;
    overflow: hidden; /* 微放大时裁掉溢出 */
  }
  .feed-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: center;
    will-change: transform;
  }
  /* 顶部固定渐变阴影：CSS 叠加层，覆盖静态图 / 帧序列 / 视频，换素材自动保留 */
  .feed-poster::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
    z-index: 2;
  }
  /* 帧序列擦洗画布：盖在静态 poster 上，帧就绪后显示 */
  .scrub-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .scrub-canvas.ready { opacity: 1; }

  /* ============ 移动端 ============ */
  @media (max-width: 768px) {
    .landing-blurb { left: 20px; max-width: 60%; }
    .landing-about { right: 20px; }
    .landing-wordmark { font-size: clamp(2.25rem, 11vw, 3.5rem); padding: 0 20px; }

    .tuner-inner { padding: 10px 20px 10px; }
    .tn-scale { height: 64px; }

    /* 列表流：不 sticky、短幅海报一条条排 */
    .feed-item {
      position: static;
      height: auto;
    }
    .feed-meta { flex-wrap: wrap; gap: 4px 12px; padding: 12px 20px; }
    .feed-title { white-space: normal; flex-basis: 100%; order: 5; font-size: 1.25rem; }
    .feed-view { display: none; } /* 整卡可点，链接提示省掉 */
    .feed-poster {
      flex: none;
      height: clamp(150px, 30vh, 260px);
    }
  }
</style>

<script>
  // ============================================================
  // 着陆首屏 + 固定调频器 + 项目流
  //  · 着陆屏（大字居中）滚走后调频器滑入，只剩调频器固定顶部
  //  · 指针配重物理 / 拖动惯性投掷 / 棘轮凹槽（同前版）
  //  · 到位瞬间：标题乱码翻牌 + 海报像素揭示
  // ============================================================
  type Station = { id: string; pos: number; freq: string };

  function setupTuner() {
    const tuner = document.getElementById('tuner');
    const dataEl = document.getElementById('stations-data');
    const feed = document.getElementById('feed');
    if (!tuner || !dataEl || !feed || tuner.dataset.bound) return;
    tuner.dataset.bound = '1';

    const stations: Station[] = JSON.parse(dataEl.textContent || '[]');
    const items = Array.from(feed.querySelectorAll<HTMLElement>('.feed-item'));
    if (stations.length === 0 || items.length !== stations.length) return;

    const scale = document.getElementById('tn-scale')!;
    const needle = document.getElementById('tn-needle')!;
    const stationBtns = Array.from(tuner.querySelectorAll<HTMLElement>('.tn-station'));

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobileMq = window.matchMedia('(max-width: 768px)');
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const clamp01 = (x: number) => Math.min(1, Math.max(0, x));

    let currentIdx = -1;
    let dragging = false;

    // ---------- 面板高度 → sticky 偏移 ----------
    const setPanelH = () => {
      document.documentElement.style.setProperty('--tuner-h', tuner.offsetHeight + 'px');
    };
    setPanelH();
    new ResizeObserver(setPanelH).observe(tuner);

    // ---------- 指针物理：target → physical 追赶 ----------
    let tv = stations[0].pos;
    let pv = tv;
    let physRaf = 0;
    const drawNeedle = (v: number) => {
      needle.style.transform = `translateX(${v * scale.clientWidth}px)`;
    };

    const physTick = () => {
      pv += (tv - pv) * (reduced ? 1 : dragging ? 0.5 : 0.22);
      if (Math.abs(tv - pv) < 0.0004) {
        pv = tv;
        drawNeedle(pv);
        physRaf = 0;
        return;
      }
      drawNeedle(pv);
      physRaf = requestAnimationFrame(physTick);
    };
    const setTarget = (v: number) => {
      tv = clamp01(v);
      if (!physRaf) physRaf = requestAnimationFrame(physTick);
    };

    // ---------- 帧序列擦洗（滚动正放 / 上滚倒带）----------
    type Scrub = {
      item: HTMLElement; canvas: HTMLCanvasElement; ctx: CanvasRenderingContext2D;
      imgs: HTMLImageElement[]; count: number; ready: boolean; lastIdx: number;
    };
    const scrubs: Scrub[] = [];
    // 桌面 + 允许动效才预载帧；移动端 / reduced 直接用静态 poster，省流量
    if (!mobileMq.matches && !reduced) {
      items.forEach(item => {
        const base = item.dataset.framesBase;
        const count = Number(item.dataset.framesCount || 0);
        const ext = item.dataset.framesExt || 'jpg';
        const canvas = item.querySelector<HTMLCanvasElement>('.scrub-canvas');
        if (!base || !count || !canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const imgs: HTMLImageElement[] = [];
        let loaded = 0;
        const s: Scrub = { item, canvas, ctx, imgs, count, ready: false, lastIdx: -1 };
        for (let k = 1; k <= count; k++) {
          const im = new Image();
          im.decoding = 'async';
          // onload/onerror 必须在 src 之前挂，否则缓存命中的帧会先触发 load、计数漏掉，导致永不 ready
          const done = () => {
            if (++loaded === count) {
              s.ready = true;
              canvas.classList.add('ready');
              sizeScrub(s);
              drawScrub(s, 0);
            }
          };
          im.onload = done;
          im.onerror = done; // 单帧失败也别卡死整组
          im.src = base + String(k).padStart(2, '0') + '.' + ext;
          imgs.push(im);
        }
        scrubs.push(s);
      });
    }

    // 静态封面：随滚动微放大（adoratorio 式，帧序列项不参与——它们是 canvas）
    const statics = items
      .map(item => ({ item, img: item.querySelector<HTMLImageElement>('.feed-poster img') }))
      .filter(s => s.img && !item2hasFrames(s.item)) as { item: HTMLElement; img: HTMLImageElement }[];
    function item2hasFrames(el: HTMLElement) { return !!el.dataset.framesBase; }

    const sizeScrub = (s: Scrub) => {
      const host = s.item.querySelector<HTMLElement>('.feed-poster');
      if (!host) return;
      const w = host.clientWidth, h = host.clientHeight;
      if (!w || !h) return;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      s.canvas.width = Math.round(w * dpr);
      s.canvas.height = Math.round(h * dpr);
      s.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      s.lastIdx = -1; // 尺寸变了强制重绘
    };
    const drawScrub = (s: Scrub, idx: number) => {
      if (!s.ready) return;
      idx = Math.max(0, Math.min(s.count - 1, Math.round(idx)));
      if (idx === s.lastIdx) return;
      const im = s.imgs[idx];
      if (!im || !im.complete || !im.naturalWidth) return;
      const host = s.item.querySelector<HTMLElement>('.feed-poster');
      if (!host) return;
      const w = host.clientWidth, h = host.clientHeight;
      if (!s.canvas.width) sizeScrub(s);
      const scale = Math.max(w / im.naturalWidth, h / im.naturalHeight);
      const dw = im.naturalWidth * scale, dh = im.naturalHeight * scale;
      s.ctx.clearRect(0, 0, w, h);
      s.ctx.drawImage(im, (w - dw) / 2, (h - dh) / 2, dw, dh);
      s.lastIdx = idx;
    };
    window.addEventListener('resize', () => scrubs.forEach(s => { sizeScrub(s); drawScrub(s, s.lastIdx < 0 ? 0 : s.lastIdx); }));

    // ---------- 台切换：高亮 + 标题翻牌 + 海报揭示 ----------
    const setStation = (i: number) => {
      if (i === currentIdx) return;
      currentIdx = i;
      stationBtns.forEach((b, bi) => b.classList.toggle('is-active', bi === i));

      // 到位瞬间：标题乱码翻牌（海报直接静态显示，无像素揭示）
      if (!reduced) {
        items[i]
          .querySelectorAll<HTMLElement>('.feed-title .lang-zh, .feed-title .lang-en')
          .forEach(el => {
            if (el.offsetParent !== null) (window as any).__fx?.scramble?.(el, { stagger: 18, jitter: 90 });
          });
      }
    };

    // ---------- 几何 ----------
    const itemH = () => items[0].offsetHeight || 1;
    // 项目流起点：第一张钉住时的 scrollY（着陆屏高度 - 面板高度）
    // 注意不能用 items[0].offsetTop——sticky 钉住后 offsetTop 会随滚动漂移（自引用）
    const feedStart = () => feed.offsetTop - tuner.offsetHeight;
    const anchorY = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      return r.top + r.height / 2 - window.innerHeight / 2;
    };
    const progress = (): { i: number; frac: number } => {
      if (!mobileMq.matches) {
        const raw = Math.min(items.length - 1, Math.max(0, (window.scrollY - feedStart()) / itemH()));
        const i = Math.min(items.length - 2, Math.floor(raw));
        return { i, frac: Math.min(1, raw - i) };
      }
      let i = 0;
      while (i < items.length - 1 && anchorY(items[i + 1]) < 0) i++;
      const a = anchorY(items[i]);
      if (a >= 0 || i === items.length - 1) return { i, frac: 0 };
      const b = anchorY(items[i + 1]);
      return { i, frac: clamp01(a / (a - b)) };
    };

    const DETENT = 0.18;
    const detent = (t: number) => (t <= DETENT ? 0 : t >= 1 - DETENT ? 1 : (t - DETENT) / (1 - 2 * DETENT));

    const renderFromScroll = () => {
      // 着陆屏内：面板藏起；滚进项目流：面板滑入
      tuner.classList.toggle('is-on', window.scrollY >= feedStart() - 4);

      const { i, frac } = progress();
      const t = detent(frac);
      const v = i >= items.length - 1 ? stations[items.length - 1].pos : lerp(stations[i].pos, stations[i + 1].pos, t);
      setTarget(v);

      setStation(frac < 0.5 ? i : Math.min(items.length - 1, i + 1));

      // 帧序列擦洗：贯穿海报的整个可见周期播放
      //   前半 = 自身从视口底部升起到钉住（riseP 0→1）
      //   后半 = 钉住后被下一张从底部升起盖住（coverP 0→1）
      //   合成 p=(riseP+coverP)/2：p=0 刚露头（首帧）→ p=0.5 到位 → p=1 被完全盖住（末帧）
      //   上滚时全程反向回退＝倒带；最后一张无覆盖阶段，升起即播完
      const stickyTop = tuner.offsetHeight;
      const vh = window.innerHeight;
      const denom = vh - stickyTop || 1;
      scrubs.forEach(s => {
        const idx = Number(s.item.dataset.idx);
        const riseP = clamp01((vh - s.item.getBoundingClientRect().top) / denom);
        let p = riseP;
        if (idx + 1 < items.length) {
          const coverP = clamp01((vh - items[idx + 1].getBoundingClientRect().top) / denom);
          p = (riseP + coverP) / 2;
        }
        drawScrub(s, p * (s.count - 1));
      });

      // 静态封面微放大：同样按生命周期 p，scale 1→1.06（adoratorio 式，桌面）
      if (!mobileMq.matches && !reduced) {
        statics.forEach(({ item, img }) => {
          const idx = Number(item.dataset.idx);
          const riseP = clamp01((vh - item.getBoundingClientRect().top) / denom);
          let p = riseP;
          if (idx + 1 < items.length) {
            const coverP = clamp01((vh - items[idx + 1].getBoundingClientRect().top) / denom);
            p = (riseP + coverP) / 2;
          }
          img.style.transform = `scale(${(1 + p * 0.06).toFixed(4)})`;
        });
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (dragging || ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        try { renderFromScroll(); } finally { ticking = false; }
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    // ---------- 指针 → 滚动 ----------
    const scrollToItem = (i: number) => {
      const top = mobileMq.matches ? items[i].offsetTop - tuner.offsetHeight : feedStart() + i * itemH();
      window.scrollTo({ top, behavior: reduced ? 'auto' : 'smooth' });
    };

    // 拖红线：跟手 + 速度采样；松手按惯性投掷落台
    let lastX = 0, lastT = 0, velocity = 0;
    const posFromX = (clientX: number) => {
      const rect = scale.getBoundingClientRect();
      return clamp01((clientX - rect.left) / rect.width);
    };
    scale.addEventListener('pointerdown', e => {
      if ((e.target as HTMLElement).closest('.tn-station')) return;
      dragging = true;
      scale.setPointerCapture(e.pointerId);
      lastX = e.clientX;
      lastT = performance.now();
      velocity = 0;
      setTarget(posFromX(e.clientX));
    });
    scale.addEventListener('pointermove', e => {
      if (!dragging) return;
      const now = performance.now();
      const x = posFromX(e.clientX);
      const dt = Math.max(1, now - lastT);
      velocity = velocity * 0.7 + ((x - posFromX(lastX)) / dt) * 0.3;
      lastX = e.clientX;
      lastT = now;
      setTarget(x);
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      const projected = clamp01(tv + velocity * 140);
      let best = 0, bd = Infinity;
      stations.forEach((s, i) => {
        const d = Math.abs(s.pos - projected);
        if (d < bd) { bd = d; best = i; }
      });
      scrollToItem(best);
      velocity = 0;
    };
    scale.addEventListener('pointerup', endDrag);
    scale.addEventListener('pointercancel', endDrag);
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('blur', () => { dragging = false; });

    // 点频点跳台
    stationBtns.forEach(btn => {
      btn.addEventListener('click', () => scrollToItem(Number(btn.dataset.idx)));
    });

    // 方向键换台
    tuner.addEventListener('keydown', e => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      const next = Math.min(stations.length - 1, Math.max(0, currentIdx + (e.key === 'ArrowRight' ? 1 : -1)));
      scrollToItem(next);
    });

    mobileMq.addEventListener?.('change', () => renderFromScroll());

    // 着陆页大字：乱码翻牌循环（只在着陆屏可见时播）
    const wordmarkSpans = Array.from(
      document.querySelectorAll<HTMLElement>('.landing-wordmark span')
    );
    if (wordmarkSpans.length && !reduced) {
      const wmLoop = () => {
        if (document.hidden || window.scrollY > window.innerHeight * 0.6) return;
        wordmarkSpans.forEach(el => {
          if (el.offsetParent !== null) (window as any).__fx?.scramble?.(el, { stagger: 60, jitter: 220 });
        });
      };
      // ClientRouter 换页不销毁 interval，先清掉旧的
      if ((window as any).__wmLoop) window.clearInterval((window as any).__wmLoop);
      window.setTimeout(wmLoop, 500); // 进场先来一次
      (window as any).__wmLoop = window.setInterval(wmLoop, 4200);
    }

    // 初始：setStation 会给当前项目播开机揭示 + 标题翻牌
    renderFromScroll();
  }

  setupTuner();
  document.addEventListener('astro:after-swap', setupTuner);

  // ============================================================
  // 着陆页 ASCII 场：循环漂移的字符底噪 + 鼠标「@」拖尾
  // 参考 behavior-translation 终端的手势轨迹场；白底灰阶，压在大字之下
  // ============================================================
  function setupLandingFx() {
    const canvas = document.getElementById('landing-fx') as HTMLCanvasElement | null;
    const landing = document.getElementById('landing');
    if (!canvas || !landing || canvas.dataset.bound) return;
    canvas.dataset.bound = '1';
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const AMBIENT = '.:+*#'.split('');      // 底噪从疏到密
    const TRAIL = '@#*+:.'.split('');        // 拖尾从新到旧
    const CELL = 20;                         // 字格像素
    let dpr = Math.min(2, window.devicePixelRatio || 1);
    let cols = 0, rows = 0, w = 0, h = 0;

    const resize = () => {
      w = landing.clientWidth;
      h = landing.clientHeight;
      dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(w / CELL);
      rows = Math.ceil(h / CELL);
      ctx.font = '13px ui-monospace, "SF Mono", Consolas, monospace';
      ctx.textBaseline = 'middle';
      ctx.textAlign = 'center';
    };
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(landing);

    // 鼠标轨迹点：{cx, cy, life}
    type P = { x: number; y: number; life: number };
    const trail: P[] = [];
    let mx = -999, my = -999;
    const onMove = (e: MouseEvent) => {
      const r = landing.getBoundingClientRect();
      mx = e.clientX - r.left;
      my = e.clientY - r.top;
      trail.push({ x: mx, y: my, life: 1 });
      if (trail.length > 90) trail.shift();
    };
    landing.addEventListener('mousemove', onMove);
    landing.addEventListener('mouseleave', () => { mx = -999; my = -999; });

    let t = 0;
    let raf = 0;
    const frame = () => {
      // 滚离着陆屏就停，省电
      if (window.scrollY > h * 0.9) { raf = requestAnimationFrame(frame); return; }
      t += 0.016;
      ctx.clearRect(0, 0, w, h);

      // --- 底噪：正弦叠加做出缓慢漂移的稀疏字符场 ---
      for (let gy = 0; gy < rows; gy++) {
        for (let gx = 0; gx < cols; gx++) {
          const n =
            Math.sin(gx * 0.28 + t * 0.7) * 0.5 +
            Math.sin(gy * 0.34 - t * 0.5) * 0.5 +
            Math.sin((gx + gy) * 0.18 + t * 0.9) * 0.5;
          const v = (n + 1.5) / 3; // 0..1
          if (v < 0.62) continue;   // 阈值高 → 场很稀疏、透气
          const ci = Math.min(AMBIENT.length - 1, Math.floor((v - 0.62) / 0.38 * AMBIENT.length));
          const alpha = 0.05 + (v - 0.62) * 0.22;
          ctx.fillStyle = `rgba(18,18,17,${alpha})`;
          ctx.fillText(AMBIENT[ci], gx * CELL + CELL / 2, gy * CELL + CELL / 2);
        }
      }

      // --- 鼠标周围底噪加密（吸附成一小片高亮，只扫半径内的格） ---
      if (mx > -900) {
        const R = 90;
        const gx0 = Math.max(0, Math.floor((mx - R) / CELL));
        const gx1 = Math.min(cols - 1, Math.ceil((mx + R) / CELL));
        const gy0 = Math.max(0, Math.floor((my - R) / CELL));
        const gy1 = Math.min(rows - 1, Math.ceil((my + R) / CELL));
        for (let gy = gy0; gy <= gy1; gy++) {
          for (let gx = gx0; gx <= gx1; gx++) {
            const px = gx * CELL + CELL / 2, py = gy * CELL + CELL / 2;
            const d = Math.hypot(px - mx, py - my);
            if (d > R) continue;
            const k = 1 - d / R;
            ctx.fillStyle = `rgba(18,18,17,${0.12 + k * 0.35})`;
            ctx.fillText(AMBIENT[Math.min(AMBIENT.length - 1, Math.floor(k * AMBIENT.length))], px, py);
          }
        }
      }

      // --- 「@」拖尾：跟随最近轨迹，新点亮旧点淡 ---
      for (let i = 0; i < trail.length; i++) {
        const p = trail[i];
        p.life -= 0.012;
        if (p.life <= 0) continue;
        const ci = Math.floor((1 - p.life) * (TRAIL.length - 1));
        ctx.fillStyle = `rgba(18,18,17,${Math.min(0.85, p.life)})`;
        ctx.fillText(TRAIL[ci], Math.round(p.x / CELL) * CELL + CELL / 2, Math.round(p.y / CELL) * CELL + CELL / 2);
      }
      while (trail.length && trail[0].life <= 0) trail.shift();

      raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);

    // 换页清理，避免多实例叠加
    if ((window as any).__landingFxCleanup) (window as any).__landingFxCleanup();
    (window as any).__landingFxCleanup = () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      landing.removeEventListener('mousemove', onMove);
    };
  }
  setupLandingFx();
  document.addEventListener('astro:after-swap', setupLandingFx);
</script>
