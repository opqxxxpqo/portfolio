---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import LangToggle from '~/components/LangToggle.astro';
import ThemeToggle from '~/components/ThemeToggle.astro';
import { CATEGORY_MAP } from '~/lib/categories';

const all = await getCollection('works');

// 隐藏 hidden:true 的作品（合集子项），按时间倒序
const works = all
  .filter(w => !w.data.hidden)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const yearFmt = (d: Date) => d.getFullYear().toString();
const pad = (n: number) => n.toString().padStart(2, '0');

// 每个作品是一个频点，均匀铺在 FM 频段上；滚动位置 ↔ 指针位置 双向绑定
const stations = works.map((w, i) => {
  const cat = CATEGORY_MAP[w.data.category as keyof typeof CATEGORY_MAP];
  const pos = (i + 0.5) / works.length; // 0..1 频段位置
  return {
    id: w.id,
    pos,
    freq: (87.5 + pos * (108 - 87.5)).toFixed(1),
    titleZh: w.data.title,
    titleEn: (w.data as any).titleEn || w.data.title,
    year: yearFmt(w.data.date)
  };
});
const first = stations[0];
---

<BaseLayout
  hideHeader
  title="鲁琦 Qi Lu · 作品集"
  description="拉夫堡大学服务设计创新硕士 · 视觉传达背景 · 服务设计 / UX·UI / AI 原型 / 视觉与 3D · 持续更新"
>
  <!-- ========== 固定调频器面板（自带导航，替代全站 Header） ========== -->
  <section class="tuner" id="tuner" data-skin="dark" tabindex="0" aria-label="Project tuner">
    <div class="tuner-inner">
      <!-- 顶行：台标 · 定位语 · 导航 · 语言/主题 · 皮肤 · 频率读数 -->
      <div class="tuner-top">
        <a href="/" class="tn-brand mono-label">QI LU — FM</a>
        <p class="tn-tagline mono-label">
          <span class="lang-zh"><span data-scramble>设计工程师 · 交付能落地的 AI 原型</span></span>
          <span class="lang-en"><span data-scramble>DESIGN ENGINEER — SHIPPING AI PROTOTYPES THAT WORK</span></span>
        </p>
        <nav class="tn-nav" aria-label="Site">
          <a href="/categories" class="mono-label" data-scramble-hover>
            <span class="lang-zh"><span data-scramble>分类</span></span>
            <span class="lang-en"><span data-scramble>CATEGORIES</span></span>
          </a>
          <a href="/about" class="mono-label" data-scramble-hover>
            <span class="lang-zh"><span data-scramble>关于</span></span>
            <span class="lang-en"><span data-scramble>ABOUT</span></span>
          </a>
        </nav>
        <div class="tn-tools">
          <LangToggle />
          <ThemeToggle />
          <button class="tn-skin mono-label" id="tn-skin" type="button" title="面板明暗 A/B">◐</button>
        </div>
        <span class="tn-freq" id="tn-freq">{first.freq}<small> MHz</small></span>
      </div>

      <!-- 频率刻度带 + 红色指针 -->
      <div class="tn-scale" id="tn-scale">
        <div class="tn-ticks" aria-hidden="true"></div>
        {stations.map((s, i) => (
          <button
            class="tn-station"
            type="button"
            style={`left:${s.pos * 100}%`}
            data-idx={i}
            aria-label={`${s.titleZh} — ${s.freq} MHz`}
          >
            <span class="tn-station-mark" aria-hidden="true"></span>
            <span class="tn-station-no mono-label">{pad(i + 1)}</span>
          </button>
        ))}
        <div class="tn-needle" id="tn-needle" aria-hidden="true"></div>
      </div>

      <!-- 底行：当前台名 · 提示 · 信号强度 -->
      <div class="tuner-bottom">
        <span class="tn-now mono-label">
          <span id="tn-idx">{pad(1)}</span>/{pad(stations.length)} ·
          <span class="lang-zh"><span id="tn-name-zh" data-scramble>{first.titleZh}</span></span>
          <span class="lang-en"><span id="tn-name-en" data-scramble>{first.titleEn}</span></span>
        </span>
        <span class="tn-hint mono-label" aria-hidden="true">
          <span class="lang-zh">滚动或拖动红线调台 ↓</span>
          <span class="lang-en">SCROLL OR DRAG THE RED LINE ↓</span>
        </span>
        <span class="tn-signal" id="tn-signal" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i>
        </span>
      </div>
    </div>
  </section>

  <!-- ========== 项目流：滚动逐个从下方升起 ========== -->
  <div class="feed" id="feed">
    {works.map((w, i) => {
      const cat = CATEGORY_MAP[w.data.category as keyof typeof CATEGORY_MAP];
      return (
        <a class="feed-item" data-idx={i} id={`fi-${i}`} href={`/works/${w.id}`} data-astro-prefetch>
          <span class="feed-meta">
            <span class="feed-idx mono-label">{pad(i + 1)}</span>
            <span class="feed-title">
              <span class="lang-zh">{w.data.title}</span>
              <span class="lang-en">{(w.data as any).titleEn || w.data.title}</span>
            </span>
            <span class="feed-cat mono-label">
              <span class="lang-zh">{w.data.chip || cat?.labelZh || cat?.label || w.data.category}</span>
              <span class="lang-en">{w.data.chipEn || w.data.chip || cat?.label || w.data.category}</span>
              <span class="feed-year">( {yearFmt(w.data.date)} )</span>
            </span>
            <span class="feed-view mono-label" aria-hidden="true">
              <span class="lang-zh">查看 case study →</span>
              <span class="lang-en">VIEW CASE STUDY →</span>
            </span>
          </span>
          <span class="feed-poster px-host">
            <img
              src={(w.data as any).poster || w.data.cover}
              alt={`${w.data.title} 海报`}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              data-pixelate
            />
          </span>
        </a>
      );
    })}
  </div>

  <script type="application/json" id="stations-data" set:html={JSON.stringify(stations)} />
</BaseLayout>

<style>
  /* ============ 固定调频器面板 ============ */
  .tuner {
    /* 皮肤变量：A = 深色硬件 HUD */
    --tn-bg: #121211;
    --tn-fg: #e6e5e1;
    --tn-muted: #85847b;
    --tn-line: rgba(230, 229, 225, 0.25);
    --tn-red: #e5352b;

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--tn-bg);
    color: var(--tn-fg);
    border-bottom: 1px solid var(--hairline);
    outline: none;
    user-select: none;
  }
  /* 皮肤 B = 灰白纸面 */
  .tuner[data-skin='paper'] {
    --tn-bg: var(--bg);
    --tn-fg: var(--fg);
    --tn-muted: var(--fg-muted);
    --tn-line: var(--hairline);
  }
  .tuner-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 14px 32px 16px;
  }

  .tuner-top {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .tuner-top .mono-label { color: var(--tn-muted); }
  .tn-brand { color: var(--tn-fg) !important; white-space: nowrap; }
  .tn-tagline {
    flex: 1;
    margin: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tn-nav { display: flex; gap: 16px; }
  .tn-nav a { white-space: nowrap; transition: color var(--transition); }
  .tn-nav a:hover { color: var(--tn-fg); }
  .tn-tools { display: flex; gap: 6px; align-items: center; }
  /* 面板里的语言/主题切换钮：跟随面板皮肤配色 */
  .tn-tools :global(button) {
    background: transparent !important;
    border-color: var(--tn-line) !important;
    color: var(--tn-fg) !important;
    height: 30px !important;
  }
  .tn-skin {
    background: none;
    border: 1px solid var(--tn-line);
    color: var(--tn-muted);
    height: 30px;
    padding: 0 8px;
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition);
  }
  .tn-skin:hover { color: var(--tn-fg); border-color: var(--tn-fg); }
  .tn-freq {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--tn-fg);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    min-width: 7ch;
    text-align: right;
  }
  .tn-freq small { font-size: 0.625rem; color: var(--tn-muted); letter-spacing: 0.12em; }

  /* 刻度带 */
  .tn-scale {
    position: relative;
    height: 64px;
    margin: 12px 0 10px;
    cursor: ew-resize;
    touch-action: none;
  }
  .tn-ticks {
    position: absolute;
    inset: 10px 0 22px;
    background-image: repeating-linear-gradient(
      to right,
      var(--tn-line) 0,
      var(--tn-line) 1px,
      transparent 1px,
      transparent 9px
    );
  }
  .tn-ticks::after {
    content: '';
    position: absolute;
    inset: -5px 0 0;
    background-image: repeating-linear-gradient(
      to right,
      var(--tn-line) 0,
      var(--tn-line) 1px,
      transparent 1px,
      transparent 45px
    );
  }
  .tn-station {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 28px;
    transform: translateX(-50%);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .tn-station-mark {
    position: absolute;
    left: 50%;
    top: 3px;
    bottom: 20px;
    width: 3px;
    transform: translateX(-50%);
    background: var(--tn-fg);
    opacity: 0.75;
    transition: opacity var(--transition), background var(--transition);
  }
  .tn-station:hover .tn-station-mark { opacity: 1; }
  .tn-station.is-active .tn-station-mark { background: var(--tn-red); opacity: 1; }
  .tn-station-no {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    color: var(--tn-muted);
    font-size: 0.625rem;
    transition: color var(--transition);
  }
  .tn-station.is-active .tn-station-no { color: var(--tn-red); }

  .tn-needle {
    position: absolute;
    top: -4px;
    bottom: 12px;
    left: 0;
    width: 2px;
    background: var(--tn-red);
    box-shadow: 0 0 8px rgba(229, 53, 43, 0.55);
    pointer-events: none;
    will-change: transform;
  }
  .tn-needle::after {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--tn-red);
  }

  .tuner-bottom {
    display: flex;
    align-items: baseline;
    gap: 24px;
  }
  .tuner-bottom .mono-label { color: var(--tn-muted); }
  .tn-now { color: var(--tn-fg) !important; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tn-hint { flex: 1; text-align: right; }
  .tn-signal { display: inline-flex; gap: 3px; align-items: flex-end; }
  .tn-signal i {
    width: 4px;
    background: var(--tn-muted);
    opacity: 0.35;
    transition: opacity 120ms ease, background 120ms ease;
  }
  .tn-signal i:nth-child(1) { height: 5px; }
  .tn-signal i:nth-child(2) { height: 8px; }
  .tn-signal i:nth-child(3) { height: 11px; }
  .tn-signal i:nth-child(4) { height: 14px; }
  .tn-signal i:nth-child(5) { height: 17px; }
  .tn-signal i.on { background: var(--tn-red); opacity: 1; }

  /* ============ 项目流 ============ */
  .feed {
    /* 顶部空出固定面板高度，JS 量实际高度后写 --tuner-h */
    padding-top: var(--tuner-h, 170px);
  }
  .feed-item {
    display: block;
    color: var(--fg);
    border-bottom: 1px solid var(--hairline);
  }
  .feed-meta {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 18px 32px;
  }
  .feed-title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .feed-cat { white-space: nowrap; }
  .feed-year { margin-left: 6px; }
  .feed-view {
    margin-left: auto;
    color: var(--fg);
    border-bottom: 1px solid var(--fg);
    padding-bottom: 2px;
    white-space: nowrap;
    transition: color var(--transition), border-color var(--transition);
  }
  .feed-item:hover .feed-view { color: var(--accent); border-color: var(--accent); }

  .feed-poster {
    display: block;
    width: 100%;
    height: clamp(380px, 74vh, 760px);
    background: #0c0c0b;
  }
  .feed-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ============ 移动端 ============ */
  @media (max-width: 768px) {
    .tuner-inner { padding: 12px 20px 12px; }
    .tuner-top { flex-wrap: wrap; gap: 8px 14px; }
    .tn-tagline { display: none; } /* 手机端定位语让位给导航 */
    .tn-nav { gap: 12px; }
    .tn-freq { margin-left: auto; font-size: 1.0625rem; }
    .tn-scale { height: 54px; margin: 10px 0 8px; }
    .tuner-bottom { gap: 12px; }
    .tn-hint { display: none; }
    .tn-signal { margin-left: auto; }

    .feed { padding-top: var(--tuner-h, 150px); }
    .feed-meta { flex-wrap: wrap; gap: 6px 12px; padding: 14px 20px; }
    .feed-title { white-space: normal; flex-basis: 100%; order: 5; }
    .feed-view { margin-left: 0; }
    .feed-poster { height: clamp(240px, 46vh, 420px); }
  }
</style>

<script>
  // ============================================================
  // 固定调频器 + 项目流：滚动即调台（双向绑定）
  //  · 页面滚到哪个项目，红针扫到对应频点，读数/信号/台名跟着变
  //  · 拖红线松手 / 点频点 / 方向键 → 平滑滚动到对应项目
  // ============================================================
  type Station = {
    id: string; pos: number; freq: string;
    titleZh: string; titleEn: string; year: string;
  };

  function setupTuner() {
    const tuner = document.getElementById('tuner');
    const dataEl = document.getElementById('stations-data');
    const feed = document.getElementById('feed');
    if (!tuner || !dataEl || !feed || tuner.dataset.bound) return;
    tuner.dataset.bound = '1';

    const stations: Station[] = JSON.parse(dataEl.textContent || '[]');
    const items = Array.from(feed.querySelectorAll<HTMLElement>('.feed-item'));
    if (stations.length === 0 || items.length !== stations.length) return;

    const scale = document.getElementById('tn-scale')!;
    const needle = document.getElementById('tn-needle')!;
    const freqEl = document.getElementById('tn-freq')!;
    const idxEl = document.getElementById('tn-idx')!;
    const nameZh = document.getElementById('tn-name-zh')!;
    const nameEn = document.getElementById('tn-name-en')!;
    const signal = document.getElementById('tn-signal')!;
    const signalBars = Array.from(signal.querySelectorAll('i'));
    const stationBtns = Array.from(tuner.querySelectorAll<HTMLElement>('.tn-station'));

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pad2 = (n: number) => String(n + 1).padStart(2, '0');
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    let currentIdx = -1;
    let dragging = false;

    // ---------- 面板高度 → 项目流顶部留白 ----------
    const setPanelH = () => {
      document.documentElement.style.setProperty('--tuner-h', tuner.offsetHeight + 'px');
    };
    setPanelH();
    new ResizeObserver(setPanelH).observe(tuner);

    // ---------- 台名/编号切换 ----------
    const scrambleEl = (el: HTMLElement) => (window as any).__fx?.scramble?.(el, { stagger: 16, jitter: 80 });
    const setStation = (i: number) => {
      if (i === currentIdx) return;
      currentIdx = i;
      const s = stations[i];
      idxEl.textContent = pad2(i);
      for (const [el, txt] of [[nameZh, s.titleZh], [nameEn, s.titleEn]] as [HTMLElement, string][]) {
        el.dataset.fxText = txt;
        el.textContent = txt;
        if (!reduced) scrambleEl(el);
      }
      stationBtns.forEach((b, bi) => b.classList.toggle('is-active', bi === i));
    };

    // ---------- 滚动位置 → 指针/读数/信号 ----------
    // 项目 i 的「对准点」= 其海报中心过视口中心
    const anchorY = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      return r.top + r.height / 2 - window.innerHeight / 2;
    };

    const renderFromScroll = () => {
      // 找当前视口中心落在哪两个项目之间
      let i = 0;
      while (i < items.length - 1 && anchorY(items[i + 1]) < 0) i++;
      const a = anchorY(items[i]);
      let v: number;
      let nearestIdx = i;
      let offCenter = Math.abs(a);

      if (a >= 0 || i === items.length - 1) {
        v = stations[i].pos;
        // 视口中心还没到第 i 个中心（或已是最后一个）：指针停在该频点
      } else {
        const b = anchorY(items[i + 1]);
        const t = Math.min(1, Math.max(0, a / (a - b))); // a<0<b 之间的插值
        v = lerp(stations[i].pos, stations[i + 1].pos, t);
        nearestIdx = t < 0.5 ? i : i + 1;
        offCenter = Math.min(Math.abs(a), Math.abs(b));
      }

      needle.style.transform = `translateX(${v * scale.clientWidth}px)`;
      freqEl.innerHTML = (87.5 + v * (108 - 87.5)).toFixed(1) + '<small> MHz</small>';

      // 信号强度：项目中心离视口中心越近越满
      const p = Math.max(0, 1 - offCenter / (window.innerHeight * 0.45));
      signalBars.forEach((b, bi) => b.classList.toggle('on', bi < Math.round(p * 5)));

      setStation(nearestIdx);
    };

    let ticking = false;
    const onScroll = () => {
      if (dragging || ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        try { renderFromScroll(); } finally { ticking = false; }
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    // ---------- 指针 → 滚动 ----------
    const scrollToItem = (i: number) => {
      const panelH = tuner.offsetHeight;
      const y = items[i].offsetTop - panelH;
      window.scrollTo({ top: y, behavior: reduced ? 'auto' : 'smooth' });
    };

    // 拖红线：跟手移动指针，松手吸到最近频点并滚过去
    let ghostV = 0;
    scale.addEventListener('pointerdown', e => {
      if ((e.target as HTMLElement).closest('.tn-station')) return; // 频点交给 click
      dragging = true;
      scale.setPointerCapture(e.pointerId);
      const rect = scale.getBoundingClientRect();
      ghostV = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
      needle.style.transform = `translateX(${ghostV * scale.clientWidth}px)`;
      freqEl.innerHTML = (87.5 + ghostV * (108 - 87.5)).toFixed(1) + '<small> MHz</small>';
    });
    scale.addEventListener('pointermove', e => {
      if (!dragging) return;
      const rect = scale.getBoundingClientRect();
      ghostV = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
      needle.style.transform = `translateX(${ghostV * scale.clientWidth}px)`;
      freqEl.innerHTML = (87.5 + ghostV * (108 - 87.5)).toFixed(1) + '<small> MHz</small>';
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      // 吸到最近频点
      let best = 0, bd = Infinity;
      stations.forEach((s, i) => {
        const d = Math.abs(s.pos - ghostV);
        if (d < bd) { bd = d; best = i; }
      });
      scrollToItem(best);
    };
    scale.addEventListener('pointerup', endDrag);
    scale.addEventListener('pointercancel', endDrag);
    // 兜底：抬手发生在刻度带外（或指针事件丢失）也要结束拖动，否则滚动同步会被卡死
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('blur', () => { dragging = false; });

    // 点频点跳台
    stationBtns.forEach(btn => {
      btn.addEventListener('click', () => scrollToItem(Number(btn.dataset.idx)));
    });

    // 方向键换台
    tuner.addEventListener('keydown', e => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      const next = Math.min(stations.length - 1, Math.max(0, currentIdx + (e.key === 'ArrowRight' ? 1 : -1)));
      scrollToItem(next);
    });

    // 皮肤 A/B
    const skinBtn = document.getElementById('tn-skin');
    skinBtn?.addEventListener('click', () => {
      tuner.dataset.skin = tuner.dataset.skin === 'dark' ? 'paper' : 'dark';
      try { localStorage.setItem('tuner-skin', tuner.dataset.skin!); } catch (e) {}
    });
    try {
      const saved = localStorage.getItem('tuner-skin');
      if (saved === 'dark' || saved === 'paper') tuner.dataset.skin = saved;
    } catch (e) {}

    // 初始
    renderFromScroll();
  }

  setupTuner();
  document.addEventListener('astro:after-swap', setupTuner);
</script>
