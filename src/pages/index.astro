---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CATEGORY_MAP } from '~/lib/categories';

const all = await getCollection('works');

// 隐藏 hidden:true 的作品（合集子项），按时间倒序
const works = all
  .filter(w => !w.data.hidden)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const yearFmt = (d: Date) => d.getFullYear().toString();
const pad = (n: number) => n.toString().padStart(2, '0');
---

<BaseLayout
  title="鲁琦 Qi Lu · 作品集"
  description="拉夫堡大学服务设计创新硕士 · 视觉传达背景 · 服务设计 / UX·UI / AI 原型 / 视觉与 3D · 持续更新"
>
  <!-- HERO：整屏大字陈述句 -->
  <section class="hero">
    <div class="container hero-grid">
      <p class="hero-kicker mono-label">
        <span class="lang-zh"><span data-scramble>鲁琦 — 作品集 2026</span></span>
        <span class="lang-en"><span data-scramble>QI LU — PORTFOLIO 2026</span></span>
      </p>

      <h1 class="hero-statement">
        <span class="lang-zh">
          <span class="line"><span data-scramble>设计工程师，</span></span>
          <span class="line"><span data-scramble>交付能落地的</span><em class="statement-accent" data-scramble>AI 原型。</em></span>
        </span>
        <span class="lang-en">
          <span class="line"><span data-scramble>DESIGN ENGINEER,</span></span>
          <span class="line"><span data-scramble>SHIPPING</span> <em class="statement-accent" data-scramble>AI PROTOTYPES</em><span data-scramble> THAT WORK.</span></span>
        </span>
      </h1>

      <div class="hero-foot">
        <p class="hero-sub">
          <span class="lang-zh">拉夫堡大学 服务设计创新硕士<br />视觉传达背景 · 现居英国</span>
          <span class="lang-en">MSc Service Design Innovation, Loughborough<br />Visual communication background · Based in the UK</span>
        </p>
        <div class="hero-links">
          <a href="mailto:luqiapp2007@163.com" class="hero-link" data-scramble-hover>
            <span class="lang-zh"><span data-scramble>邮件 ↗</span></span>
            <span class="lang-en"><span data-scramble>EMAIL ↗</span></span>
          </a>
          <a href="/resume.pdf" class="hero-link" data-scramble-hover>
            <span class="lang-zh"><span data-scramble>简历 PDF ↓</span></span>
            <span class="lang-en"><span data-scramble>RESUME PDF ↓</span></span>
          </a>
        </div>
      </div>

      <p class="hero-scroll mono-label" aria-hidden="true">
        <span class="lang-zh">下滑查看 {works.length} 件作品 ↓</span>
        <span class="lang-en">SCROLL — {works.length} WORKS ↓</span>
      </p>
    </div>
  </section>

  <!-- WORKS：行式索引 + 浮动媒体预览 -->
  <section class="works" id="works">
    <div class="container">
      <div class="works-head">
        <span class="mono-label">
          <span class="lang-zh">作品 — <span id="works-count">{pad(works.length)}</span> · 时间倒序</span>
          <span class="lang-en">WORKS — <span id="works-count-en">{pad(works.length)}</span> · LATEST FIRST</span>
        </span>
        <label class="ai-filter" for="ai-only">
          <input type="checkbox" id="ai-only" />
          <span class="ai-filter-box" aria-hidden="true"></span>
          <span class="ai-filter-label mono-label">
            <span class="lang-zh">只看 AI 辅助</span>
            <span class="lang-en">AI-ASSISTED ONLY</span>
          </span>
        </label>
      </div>

      <ol class="rows">
        {works.map((w, i) => {
          const cat = CATEGORY_MAP[w.data.category as keyof typeof CATEGORY_MAP];
          return (
            <li class="row" data-ai={w.data.ai ? '1' : '0'}>
              <a
                href={`/works/${w.id}`}
                class="row-link"
                data-preview={w.data.cover}
                data-astro-prefetch
              >
                <span class="row-idx mono-label">{pad(i + 1)}</span>
                <span class="row-main">
                  <span class="row-thumb px-host" aria-hidden="true">
                    <img src={w.data.cover} alt="" loading="lazy" decoding="async" data-pixelate />
                  </span>
                  <h2 class="row-title">
                    <span class="lang-zh">{w.data.title}</span>
                    <span class="lang-en">{(w.data as any).titleEn || w.data.title}</span>
                  </h2>
                </span>
                <span class="row-meta">
                  <span class="row-cat">
                    <span class="lang-zh">{w.data.chip || cat?.labelZh || cat?.label || w.data.category}</span>
                    <span class="lang-en">{w.data.chipEn || w.data.chip || cat?.label || w.data.category}</span>
                  </span>
                  <span class="row-year mono-label">{yearFmt(w.data.date)}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>

    <!-- 浮动预览：桌面 hover 行时跟随光标（指针粗糙设备不启用） -->
    <div class="row-preview px-host" id="row-preview" aria-hidden="true">
      <img id="row-preview-img" src="" alt="" decoding="async" />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    min-height: calc(100svh - 61px); /* 视口高减 header */
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-grid {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-top: clamp(48px, 9vh, 110px);
    padding-bottom: 28px;
  }
  .hero-kicker { margin: 0 0 auto; }

  .hero-statement {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7.2vw, 6.75rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 32px 0;
    text-transform: uppercase;
  }
  .hero-statement .line { display: block; }
  .statement-accent {
    font-style: normal;
    color: var(--accent);
    white-space: nowrap;
  }

  .hero-foot {
    margin-top: auto;
    padding-top: 32px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    border-top: 1px solid var(--hairline);
  }
  .hero-sub {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0;
  }
  .hero-links { display: flex; gap: 28px; }
  .hero-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg);
    border-bottom: 1px solid var(--fg);
    padding-bottom: 3px;
    transition: color var(--transition), border-color var(--transition);
  }
  .hero-link:hover { color: var(--accent); border-color: var(--accent); }

  .hero-scroll { margin: 28px 0 0; }

  /* ---------- WORKS 行式索引 ---------- */
  .works { padding: 0 0 48px; position: relative; }
  .works-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
  }

  .rows { list-style: none; margin: 0; padding: 0; }
  .row { border-top: 1px solid var(--hairline); }
  .row:last-child { border-bottom: 1px solid var(--hairline); }
  .row[hidden] { display: none; }

  .row-link {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: baseline;
    gap: 24px;
    padding: 26px 0;
    color: var(--fg);
  }
  .row-idx { transition: color var(--transition); }
  .row-main { min-width: 0; }
  .row-thumb { display: none; } /* 桌面用浮动预览，缩略图只给移动端 */

  .row-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.6vw, 3rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    transition: transform 300ms var(--ease-expo), color var(--transition);
  }
  .row-meta {
    display: flex;
    align-items: baseline;
    gap: 18px;
    white-space: nowrap;
  }
  .row-cat {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    font-weight: 500;
  }

  .row-link:hover .row-title { transform: translateX(10px); }
  .row-link:hover .row-idx { color: var(--accent); }

  /* ---------- 浮动预览 ---------- */
  .row-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 320px;
    aspect-ratio: 16 / 10;
    z-index: 40;
    pointer-events: none;
    opacity: 0;
    border: 1px solid var(--border);
    background: var(--bg-soft);
    transition: opacity 200ms ease;
    will-change: transform;
  }
  .row-preview.is-visible { opacity: 1; }
  .row-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- AI 筛选 ---------- */
  .ai-filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
  }
  .ai-filter input { position: absolute; opacity: 0; width: 0; height: 0; }
  .ai-filter-box {
    width: 14px;
    height: 14px;
    flex: none;
    border: 1px solid var(--fg);
    background: transparent;
    transition: background var(--transition);
  }
  .ai-filter input:checked + .ai-filter-box { background: var(--accent); border-color: var(--accent); }
  .ai-filter input:focus-visible + .ai-filter-box {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .ai-filter:hover .ai-filter-label { color: var(--fg); }
  .ai-filter-label { transition: color var(--transition); white-space: nowrap; }

  /* ---------- 移动端：行变堆叠卡，缩略图内联 + 像素揭示 ---------- */
  @media (max-width: 768px) {
    .hero { min-height: calc(100svh - 53px); }
    .hero-statement { font-size: clamp(2.25rem, 11vw, 4rem); margin: 24px 0; }
    .hero-foot { flex-direction: column; align-items: flex-start; gap: 20px; }
    .hero-links { gap: 20px; }

    .row-link {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 22px 0;
    }
    .row-idx { display: none; }
    .row-thumb {
      display: block;
      aspect-ratio: 16 / 10;
      background: var(--bg-soft);
      border: 1px solid var(--hairline);
      margin-bottom: 4px;
    }
    .row-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .row-title { font-size: clamp(1.375rem, 6.5vw, 1.75rem); }
    .row-link:hover .row-title { transform: none; }
    .row-meta { gap: 12px; }
    .row-preview { display: none; }

    .works-head { flex-wrap: wrap; padding: 16px 0; }
  }
</style>

<script>
  // 浮动预览：hover 行 → 预览图跟随光标（带 lerp 惯性），换行时像素揭示
  function setupPreview() {
    const preview = document.getElementById('row-preview');
    const img = document.getElementById('row-preview-img') as HTMLImageElement | null;
    const rows = Array.from(document.querySelectorAll<HTMLAnchorElement>('.row-link'));
    if (!preview || !img || rows.length === 0) return;
    if (preview.dataset.bound) return;
    preview.dataset.bound = '1';

    // 触屏/粗指针不启用
    if (!window.matchMedia('(pointer: fine)').matches) return;

    let targetX = 0, targetY = 0, curX = 0, curY = 0;
    let active = false;
    let raf = 0;

    const tick = () => {
      curX += (targetX - curX) * 0.18;
      curY += (targetY - curY) * 0.18;
      preview.style.transform = `translate3d(${curX}px, ${curY}px, 0)`;
      if (active) raf = requestAnimationFrame(tick);
    };

    const place = (e: MouseEvent) => {
      const w = 320, h = 200, gap = 28;
      let x = e.clientX + gap;
      let y = e.clientY - h / 2;
      if (x + w > window.innerWidth - 16) x = e.clientX - w - gap;
      y = Math.max(16, Math.min(window.innerHeight - h - 16, y));
      targetX = x; targetY = y;
    };

    rows.forEach(row => {
      row.addEventListener('mouseenter', e => {
        const src = row.dataset.preview;
        if (!src) return;
        if (img.getAttribute('src') !== src) {
          img.src = src;
          const reveal = () => (window as any).__fx?.pixelReveal(img, 90);
          if (img.complete) reveal();
          else img.addEventListener('load', reveal, { once: true });
        }
        place(e as MouseEvent);
        curX = targetX; curY = targetY; // 初次出现不做飞入
        preview.classList.add('is-visible');
        active = true;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(tick);
      });
      row.addEventListener('mousemove', e => place(e as MouseEvent));
      row.addEventListener('mouseleave', () => {
        preview.classList.remove('is-visible');
        active = false;
        cancelAnimationFrame(raf);
      });
    });

    // 滚动时行会从光标下滑走而不触发 mouseleave，直接收起预览
    window.addEventListener(
      'scroll',
      () => {
        if (!active) return;
        preview.classList.remove('is-visible');
        active = false;
        cancelAnimationFrame(raf);
      },
      { passive: true }
    );
  }

  // AI 筛选
  function setupFilter() {
    const aiOnly = document.getElementById('ai-only') as HTMLInputElement | null;
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.row'));
    const countZh = document.getElementById('works-count');
    const countEn = document.getElementById('works-count-en');
    if (!aiOnly || aiOnly.dataset.bound) return;
    aiOnly.dataset.bound = '1';

    const apply = (on: boolean) => {
      let visible = 0;
      rows.forEach(el => {
        const show = !on || el.dataset.ai === '1';
        el.hidden = !show;
        if (show) visible++;
      });
      const txt = visible.toString().padStart(2, '0');
      if (countZh) countZh.textContent = txt;
      if (countEn) countEn.textContent = txt;
      try { localStorage.setItem('ai-only', on ? '1' : '0'); } catch (e) {}
    };

    aiOnly.addEventListener('change', () => apply(aiOnly.checked));
    try {
      if (localStorage.getItem('ai-only') === '1') {
        aiOnly.checked = true;
        apply(true);
      }
    } catch (e) {}
  }

  function setupHome() {
    setupPreview();
    setupFilter();
  }
  setupHome();
  document.addEventListener('astro:after-swap', setupHome);
</script>
